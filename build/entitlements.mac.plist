<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for notarization.

  hardenedRuntime is mandatory for notarytool, and it forbids several things
  Electron requires. Each entry below is here because removing it breaks the app,
  not because it is conventional:

    allow-jit
    allow-unsigned-executable-memory
    allow-dyld-environment-variables
      V8 compiles JavaScript to machine code at runtime. The hardened runtime
      blocks writable-executable memory by default, so without these the renderer
      process crashes on launch — not degrades, crashes.

    disable-library-validation
      Electron loads its own frameworks and helpers, which are signed with our
      Developer ID rather than Apple's. Library validation refuses to load them.

  Nothing here grants network, camera, microphone or file access beyond what the
  app already asks for at runtime; these are code-execution entitlements only.
  Keep this file minimal — every entitlement widens the attack surface the
  hardened runtime exists to narrow, and notarization does not check whether we
  needed them.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
