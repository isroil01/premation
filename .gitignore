# Dependencies
node_modules/

# Build output
dist/
dist-electron/
out/
release/
# build/ holds electron-builder's buildResources (electron-builder.yml), not
# build output. The app icon MUST be tracked: a CI checkout without it packages
# installers with Electron's default logo. Ignore the directory's transient
# contents but never the icon. (`build/*` not `build/` — git cannot re-include
# a file under a directory that is itself ignored.)
build/*
!build/icon.png
# Required at BUILD time for notarization — not an artifact. Without it the mac
# build has no hardened-runtime entitlements and notarytool rejects the app.
!build/entitlements.mac.plist
.vite/

# Test / coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / local config
.env
.env.local
.env.*.local
# Per-deployment config, not source. This was tracked, which gave the backend
# origin TWO sources of truth — this file and the CI variable — and release.yml's
# guard only ever read the variable, so it could announce "installers point at
# localhost" while the committed file had set a real origin. CI supplies it from
# `vars.VITE_BACKEND_ORIGIN`, and the workflow now FAILS when that is missing
# rather than shipping a localhost build. See .env.production.example.
.env.production
!.env.production.example

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# AI coding-assistant config, skill packs and hooks. Local developer tooling —
# not part of the application, and not something a contributor needs or should
# inherit. Kept out of the repo rather than deleted from disk, so whoever uses
# these tools keeps them locally.
skills-lock.json
.claude/
.agents/
.cursor/
.gemini/
.codex/
.impeccable/

# playwright (electron main-process e2e)
/test-results
/playwright-report
/blob-report
