# Dependencies
node_modules/

# Build output
dist/
dist-electron/
out/
release/
# build/ holds electron-builder's buildResources (electron-builder.yml), not
# build output. The app icon MUST be tracked: a CI checkout without it packages
# installers with Electron's default logo. Ignore the directory's transient
# contents but never the icon. (`build/*` not `build/` — git cannot re-include
# a file under a directory that is itself ignored.)
build/*
!build/icon.png
.vite/

# Test / coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / local config
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# AI coding-assistant config, skill packs and hooks. Local developer tooling —
# not part of the application, and not something a contributor needs or should
# inherit. Kept out of the repo rather than deleted from disk, so whoever uses
# these tools keeps them locally.
skills-lock.json
.claude/
.agents/
.cursor/
.gemini/
.codex/
.impeccable/
