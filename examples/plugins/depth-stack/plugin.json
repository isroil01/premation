{
  "id": "studio.example.depthstack",
  "name": "Depth Stack",
  "version": "1.1.0",
  "description": "Slices the selected image into layered 3D depth cards and gives them a parallax sweep. Uses image brightness as a stand-in for depth.",
  "author": "Premation examples",
  "apiVersion": 2,
  "main": "main.js",
  "permissions": [
    "scene:read",
    "scene:write",
    "assets:read",
    "assets:write",
    "animation:write",
    "timeline"
  ],
  "contributes": {
    "panels": [
      {
        "id": "main",
        "title": "Depth Stack",
        "entry": "panel.html",
        "placement": "inspector",
        "icon": "layers"
      }
    ]
  }
}
