# Dev-mode defaults (loaded by Vite in `npm run dev` / `npm run electron:dev`;
# production builds are unaffected — see .env.local for machine-local overrides).

# Version History + `.motion` directory-bundle save/open (RFC Option B).
# The Version History section in the Settings inspector panel only works
# against bundle storage, so the flag defaults ON in dev. The panel appears
# once a `.motion` bundle project is open/saved.
VITE_LOCAL_FIRST=1
