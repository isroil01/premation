{
  "name": "motion-editor",
  "version": "0.3.0",
  "description": "AI-native motion design and animation editor for the desktop — an After Effects-class timeline, 2D/3D compositing and a GPU renderer, running entirely on your machine.",
  "license": "AGPL-3.0-only",
  "author": "Premation contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isroil01/motion-editor.git"
  },
  "homepage": "https://github.com/isroil01/motion-editor#readme",
  "bugs": {
    "url": "https://github.com/isroil01/motion-editor/issues"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:local": "cross-env VITE_EDITION=local MOTION_EDITION=local vite",
    "test": "jest",
    "test:e2e": "npm run electron:compile && playwright test",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && cross-env VITE_EDITION=local MOTION_EDITION=local vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:watch": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite\" \"npm:electron:watch\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "electron:dev:local": "npm run electron:compile && concurrently -k \"cross-env VITE_EDITION=local MOTION_EDITION=local vite\" \"npm:electron:watch\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development MOTION_EDITION=local electron dist-electron/main.js\"",
    "electron:build": "vite build && tsc -p electron/tsconfig.json",
    "electron:build:local": "cross-env VITE_EDITION=local MOTION_EDITION=local vite build && tsc -p electron/tsconfig.json",
    "electron:start": "cross-env NODE_ENV=development electron dist-electron/main.js",
    "pack": "npm run electron:build && electron-builder --dir --publish never",
    "pack:local": "npm run electron:build:local && electron-builder --dir --publish never --config.extraMetadata.edition=local",
    "pack:selfhosted": "npm run electron:build && electron-builder --dir --publish never --config electron-builder.selfhosted.yml",
    "dist": "npm run electron:build && electron-builder --publish never",
    "dist:local": "npm run electron:build:local && electron-builder --publish never --config.extraMetadata.edition=local",
    "dist:selfhosted": "npm run electron:build && electron-builder --publish never --config electron-builder.selfhosted.yml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 129",
    "worktree": "node scripts/worktree.mjs",
    "release:patch": "npm version patch -m \"release: v%s\"",
    "release:minor": "npm version minor -m \"release: v%s\"",
    "release:major": "npm version major -m \"release: v%s\"",
    "render-tests": "node packages/render-tests/scripts/run.mjs",
    "render-tests:update": "node packages/render-tests/scripts/run.mjs --update",
    "verify-plugin-effect": "node packages/render-tests/scripts/verify-plugin-effect.mjs",
    "verify:fixtures": "node scripts/fixtures-hash.mjs",
    "feature-counts": "node scripts/featureCounts.cjs",
    "icons:generate": "node scripts/generate-sharp-icons.mjs",
    "verify-plugin-chain": "node packages/render-tests/scripts/verify-plugin-chain.mjs",
    "verify-plugin-shaders": "node packages/render-tests/scripts/verify-plugin-shaders.mjs",
    "build-test-kit": "node scripts/build-test-kit-plugin.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "lucide-react": "^1.24.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "zustand": "^4.5.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@material-symbols/svg-700": "^0.45.10",
    "@napi-rs/canvas": "^1.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.3",
    "@types/node": "^22.7.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^29.6.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
