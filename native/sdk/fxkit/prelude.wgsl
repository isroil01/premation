// ── fxkit prelude (GPU side). Its C++ twin is kit::Ctx in include/premation_fxkit/runtime.hpp: keep them line for line. ──
struct Frame {
  size: vec2f,
  layer: vec2f,
  l2w_a: vec4f,
  l2w_b: vec4f,
  w2l_a: vec4f,
  w2l_b: vec4f,
  time: f32,
  scale: f32,
  quality: f32,
  debug: f32,
  comp: vec2f,
  fps: f32,
  has_aux: f32,
  comp_time: f32,
  levels: f32,
  pad0: f32,
  pad1: f32,
}
@group(0) @binding(0) var<uniform> fr: Frame;
@group(0) @binding(2) var t_src: texture_2d<f32>;
@group(0) @binding(3) var t_l1: texture_2d<f32>;
@group(0) @binding(4) var t_l2: texture_2d<f32>;
@group(0) @binding(5) var t_l3: texture_2d<f32>;
@group(0) @binding(6) var t_l4: texture_2d<f32>;
@group(0) @binding(7) var t_l5: texture_2d<f32>;
@group(0) @binding(8) var t_l6: texture_2d<f32>;
@group(0) @binding(9) var t_pa: texture_2d<f32>;
@group(0) @binding(10) var t_pb: texture_2d<f32>;
@group(0) @binding(11) var t_aux: texture_2d<f32>;

fn world_size() -> vec2f { return fr.size; }
fn layer_size() -> vec2f { return fr.layer; }
fn comp_size() -> vec2f { return fr.comp; }
fn time_s() -> f32 { return fr.time; }
fn comp_time_s() -> f32 { return fr.comp_time; }
fn fps() -> f32 { return fr.fps; }
fn px_scale() -> f32 { return fr.scale; }
fn quality() -> f32 { return fr.quality; }
fn levels() -> i32 { return i32(fr.levels); }
fn has_aux() -> bool { return fr.has_aux > 0.5; }
fn to_layer(p: vec2f) -> vec2f {
  return vec2f(fr.w2l_a.x * p.x + fr.w2l_a.y * p.y + fr.w2l_a.z, fr.w2l_b.x * p.x + fr.w2l_b.y * p.y + fr.w2l_b.z);
}
fn to_world(q: vec2f) -> vec2f {
  return vec2f(fr.l2w_a.x * q.x + fr.l2w_a.y * q.y + fr.l2w_a.z, fr.l2w_b.x * q.x + fr.l2w_b.y * q.y + fr.l2w_b.z);
}
fn layer_uv(p: vec2f) -> vec2f { return to_layer(p) / max(fr.layer, vec2f(1.0)); }
fn uv_to_world(uv: vec2f) -> vec2f { return to_world(uv * fr.layer); }

// Texture access is specialised per texture (fxk_tex_src, fxk_bil_l3, fxk_bsp_l2 …, generated by
// fxkit.mjs and appended below): a helper that took the texture as a runtime index made every
// fetch site inline a ten-way branch, and shader compiles of fetch-heavy kernels ran into seconds.
// The indexed forms stay for completeness and dispatch to the specialised ones.
fn fxk_tex(t: i32, i: vec2i) -> vec4f {
  if (t == 0) { return fxk_tex_src(i); }
  if (t == 1) { return fxk_tex_l1(i); }
  if (t == 2) { return fxk_tex_l2(i); }
  if (t == 3) { return fxk_tex_l3(i); }
  if (t == 4) { return fxk_tex_l4(i); }
  if (t == 5) { return fxk_tex_l5(i); }
  if (t == 6) { return fxk_tex_l6(i); }
  if (t == 7) { return fxk_tex_pa(i); }
  if (t == 8) { return fxk_tex_pb(i); }
  return fxk_tex_aux(i);
}
fn fxk_bilinear(t: i32, q: vec2f) -> vec4f {
  if (t == 0) { return fxk_bil_src(q); }
  if (t == 7) { return fxk_bil_pa(q); }
  if (t == 8) { return fxk_bil_pb(q); }
  if (t == 9) { return fxk_bil_aux(q); }
  let g = q - vec2f(0.5);
  let f0 = floor(g);
  let f = g - f0;
  let i = vec2i(f0);
  return mix(mix(fxk_tex(t, i), fxk_tex(t, i + vec2i(1, 0)), f.x), mix(fxk_tex(t, i + vec2i(0, 1)), fxk_tex(t, i + vec2i(1, 1)), f.x), f.y);
}
fn fxk_bweights(t: f32) -> vec4f {
  let s = 1.0 - t;
  return vec4f(s * s * s, 4.0 - 6.0 * t * t + 3.0 * t * t * t, 1.0 + 3.0 * t + 3.0 * t * t - 3.0 * t * t * t, t * t * t) * (1.0 / 6.0);
}
fn fxk_w4(w: vec4f, i: i32) -> f32 {
  if (i == 0) { return w.x; }
  if (i == 1) { return w.y; }
  if (i == 2) { return w.z; }
  return w.w;
}
fn fxk_bspline(t: i32, q: vec2f) -> vec4f {
  if (t == 1) { return fxk_bsp_l1(q); }
  if (t == 2) { return fxk_bsp_l2(q); }
  if (t == 3) { return fxk_bsp_l3(q); }
  if (t == 4) { return fxk_bsp_l4(q); }
  if (t == 5) { return fxk_bsp_l5(q); }
  return fxk_bsp_l6(q);
}
/// One pyramid step: texel j of the next level from the level bound as t_src (a 4×4 tent, 1 3 3 1).
fn fxk_down(j: vec2i) -> vec4f {
  var acc = vec4f(0.0);
  for (var y = 0; y < 4; y++) {
    var row = vec4f(0.0);
    for (var x = 0; x < 4; x++) {
      row += fxk_tex_src(vec2i(2 * j.x + x - 1, 2 * j.y + y - 1)) * fxk_w4(vec4f(0.125, 0.375, 0.375, 0.125), x);
    }
    acc += row * fxk_w4(vec4f(0.125, 0.375, 0.375, 0.125), y);
  }
  return acc;
}

fn texel(i: vec2i) -> vec4f { return fxk_tex_src(i); }
fn src(p: vec2f) -> vec4f { return fxk_bil_src(p); }
fn src_clamp(p: vec2f) -> vec4f { return fxk_bil_src(clamp(p, vec2f(0.5), vec2f(textureDimensions(t_src)) - vec2f(0.5))); }
/// Pyramid level k (1 = half size … 6), B-spline filtered, at world position p. k <= 0 is src(p).
fn level(k: i32, p: vec2f) -> vec4f {
  let kk = min(k, levels());
  if (kk <= 0) { return src(p); }
  return fxk_bspline(kk, p / exp2(f32(kk)));
}
fn pass_a(p: vec2f) -> vec4f { return fxk_bil_pa(p); }
fn pass_b(p: vec2f) -> vec4f { return fxk_bil_pb(p); }
fn pass_a_texel(i: vec2i) -> vec4f { return fxk_tex_pa(i); }
fn pass_b_texel(i: vec2i) -> vec4f { return fxk_tex_pb(i); }
fn aux(p: vec2f) -> vec4f { return fxk_bil_aux(p); }
fn aux_clamp(p: vec2f) -> vec4f { return fxk_bil_aux(clamp(p, vec2f(0.5), vec2f(textureDimensions(t_aux)) - vec2f(0.5))); }
