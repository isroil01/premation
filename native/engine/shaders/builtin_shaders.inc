  if (params.w > 0.5) { uv.y = 1.0 - uv.y; }
  if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) { return 1.0; }
  let d = dot(world - origin.xyz, axis.xyz) * axis.w - bias;
  if (d <= 0.0 || d >= 1.0) { return 1.0; }
