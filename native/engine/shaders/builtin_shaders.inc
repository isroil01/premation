        // them — mirrors lightFalloffAt exactly, including its max(1, radius).
        let r = max(1.0, radius);
        var curve = 1.0;
        if (d > r) {
          if (fMode == 1) { curve = max(0.0, 1.0 - (d - r) / max(1.0, misc2.w)); }
          else { curve = (r * r) / (d * d); }
