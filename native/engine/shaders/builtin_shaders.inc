      let G = (NdotL / (NdotL * (1.0 - kG) + kG)) * (NdotV / (NdotV * (1.0 - kG) + kG));
      let F = F0 + (vec3<f32>(1.0) - F0) * pow(1.0 - VdotH, 5.0);
      let specular = (D * G) * F / max(4.0 * NdotL * NdotV, 1e-4);
      let kd = (vec3<f32>(1.0) - F) * (1.0 - metal);
