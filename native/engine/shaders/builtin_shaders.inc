  // there, and there is nothing to derive from anyway.
  let c = textureSampleLevel(envTex, envSmp, envUv(dir, level), 0.0).rgb;
  // sqrt transfer + one scale - see EnvSpecularMap's encoding note.
  return c * c * obj.envParams.w;
