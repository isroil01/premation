// lights with correct normals (and a mirrored one keeps them outward).
fn normalMatrix(m : mat3x3<f32>) -> mat3x3<f32> {
  let c0 = cross(m[1], m[2]);
  let c1 = cross(m[2], m[0]);
  let c2 = cross(m[0], m[1]);
