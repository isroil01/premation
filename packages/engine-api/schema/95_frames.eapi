// Frame channel: the engine's SECOND connection, separate from EngineMessage.
//
// docs/VIEWPORT_ROUTE.md (C1) decided that pixels never travel over the command
// pipe: the engine renders into a ring of shared GPU textures and only announces
// "frame ready in slot N"; the host releases a slot when Chromium has finished
// with it; a full ring drops a frame and never blocks. These messages, plus the
// supervisor's heartbeat, travel on their own pipe pair — the engine's fd 3
// (engine → host) and fd 4 (host → engine) — so that a large query result never
// delays a frame announcement or a slot release, and so that a heartbeat proves
// the document core drains its queue (pong is answered by the core thread).
//
// Framing is the command pipe's: 4-byte little-endian length + one encoded
// FrameChannelMessage. A payload is at most 4096 bytes (kMaxFramePayload in
// native/protocol/include/premation/protocol/framing.hpp). These are NOT events:
// they never enter EventBatch and carry no document revision of their own
// (`revision` fields are what the frame shows / where the core was). The event
// ids 2100–2199 that ENGINE_API.md §13 reserved for the frame route stay unused.

family "FrameChannel";

enum PixelFormat { rgba8unorm = 0; }

/// Engine → host. The ring changed (first viewport, resize, GPU restart). Every slot of an older generation is gone; the host drops its imports of them.
struct FrameSlots {
  generation: u32 = 1;
  viewport: u32 = 2;
  width: u32 = 3;
  height: u32 = 4;
  format: PixelFormat = 5;
  /// true: shared slots for sharedTexture import — Windows: NT handles valid in the host process, owned by the ENGINE (the host never closes one); macOS: global IOSurfaceIDs the host resolves with IOSurfaceLookup and holds while the ring is current. false: offscreen slots (headless, tests, the route-A copy); handles are 0.
  shared: bool = 6;
  /// One per slot, at most 16.
  handles: u64[] = 7;
}

/// Engine → host. A finished frame is in `slot` (the GPU work is complete: Electron's rgba import takes no fence). The slot belongs to the host until it sends FrameRelease for this generation + slot.
struct FrameReady {
  generation: u32 = 1;
  slot: u32 = 2;
  viewport: u32 = 3;
  /// Frames not delivered since the previous FrameReady (ring full, or the clock ran ahead of the GPU).
  dropped: u32 = 4;
  /// Comp frame index.
  frame: i64 = 5;
  time: Time = 6;
  /// Document revision the frame shows.
  revision: Revision = 7;
  /// Epoch microseconds — MEASUREMENT ONLY, never an input to pixels.
  renderStartUs: f64 = 8;
  renderDoneUs: f64 = 9;
  width: u32 = 10;
  height: u32 = 11;
}

/// B4 — one subscribed layer's overlay geometry at the frame's time (setOverlayGeometry). Fields of kinds not subscribed are empty. Composition space is comp px, y down; `t` values are the layer's keyframe-axis seconds (what a Position key stores — the page's motion-path window and hover test compare them). One layer's geometry may arrive as SEVERAL records in a frame (the payload cap): the host merges them, CONCATENATING arrays in arrival order.
struct OverlayLayerGeometry {
  layer: LayerId = 1;
  /// transform: the column-major 4×4 layer → comp matrix (getLayerTransforms: a 3D layer's world matrix, else the 2D chain as a 4×4).
  matrix: f64[] = 2;
  /// bounds: readGeometry's LOCAL box as x, y, width, height (getLayerBounds, layer space) …
  box: f64[] = 3;
  /// … and its four corners through the 2D world chain: x0, y0 … x3, y3 (getLayerBounds, comp space).
  corners: f64[] = 4;
  /// motionPath: the trajectory of the layer's Position, sampled over its keyed span (16 per key segment, at least 8), as t, x, y, z quadruples: x / y through the parent's world matrix at the frame's time (comp space), z the layer's raw z (0 for 2D; the page projects a 3D layer through its view camera).
  path: f64[] = 5;
  /// motionPath: one entry per Position key time: t, x, y, z, inX, inY, outX, outY — the key's point and its spatial tangent handles at their effective positions (comp space; NaN where a handle does not exist: the path's ends, a linear vertex).
  pathKeys: f64[] = 6;
  /// rig: puppet pins as x, y pairs and bones as x0, y0, x1, y1 in comp space — not produced yet (both engines send them empty until the rig sampler moves engine-side).
  pins: f64[] = 7;
  bones: f64[] = 8;
  /// textBox: a text layer's measured box, LOCAL x, y, width, height (the fixed paragraph box, else the font-metric selection box).
  textBox: f64[] = 9;
  /// motionPath: the trajectory at every composition frame of the keyed span (AE's velocity dots): t, x, y, z quadruples as `path`.
  pathFrames: f64[] = 10;
  /// motionPath: the position at the frame's own time: x, y, z (comp space as `path`).
  pathNow: f64[] = 11;
}

/// Engine → host. The overlay geometry of the NEXT FrameReady of `viewport` with this generation and frame (B4, setOverlayGeometry). One frame's records may span several messages (the 4096-byte payload cap; a layer's kinds can arrive in separate records, and they merge): the host collects them until `last`, then delivers them with that FrameReady. Sent only while the viewport has a subscription.
struct FrameGeometry {
  viewport: u32 = 1;
  generation: u32 = 2;
  frame: i64 = 3;
  time: Time = 4;
  revision: Revision = 5;
  layers: OverlayLayerGeometry[] = 6;
  last: bool = 7;
}

/// Engine → host. Heartbeat answer, sent by the document core thread.
struct FramePong {
  nonce: u64 = 1;
  revision: Revision = 2;
  playing: bool = 3;
  /// Messages waiting in the core queue when the ping was served.
  queued: u32 = 4;
}

/// Host → engine. Chromium is done with a slot. A stale generation is ignored.
struct FrameRelease { generation: u32 = 1; slot: u32 = 2; }

/// Host → engine. Heartbeat.
struct FramePing { nonce: u64 = 1; }

/// Every message on the frame channel (fd 3 / fd 4). Unknown variants are skipped by both sides.
union FrameChannelMessage flat {
  slots: FrameSlots = 1;
  frameReady: FrameReady = 2;
  pong: FramePong = 3;
  geometry: FrameGeometry = 4;
  release: FrameRelease = 16;
  ping: FramePing = 17;
}
