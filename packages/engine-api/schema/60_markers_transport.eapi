// Markers (document), transport, viewport and preview (engine-owned, never
// in the document, never undoable). Command ids: 700–849.

family "Markers";

/// Composition marker (no layer) or layer marker (layer time).
struct MarkerOwner {
  comp: ItemId = 1;
  layer?: LayerId = 2;
}

struct Marker {
  id: MarkerId = 1;
  owner: MarkerOwner = 2;
  time: Time = 3;
  duration: Time = 4;
  name: string = 5;
  comment: string = 6;
  label: u32 = 7;
  chapter: string = 8;
  url: string = 9;
  /// Cue point name for export; empty = none.
  cuePoint: string = 10;
  /// Protected region (time-stretch of a precomp leaves it untouched).
  protectedRegion: bool = 11;
  /// B3z — the stored colour exactly (a timeline swatch token such as `var(--color-timeline-marker-blue)`, or a hex); empty = none. `label` is this colour's index in the LAYER label palette, 0 when it is not one of them.
  color: string = 12;
}

struct MarkerInsert {
  owner: MarkerOwner = 1;
  time: Time = 2;
  duration: Time = 3;
  name: string = 4;
  comment: string = 5;
  label: u32 = 6;
  /// B3z — the marker's colour as stored (a timeline swatch token or a hex, at most 128 characters); wins over `label`. Empty = no colour.
  color?: string = 7;
}

struct MarkerPatch {
  id: MarkerId = 1;
  time?: Time = 2;
  duration?: Time = 3;
  name?: string = 4;
  comment?: string = 5;
  label?: u32 = 6;
  chapter?: string = 7;
  url?: string = 8;
  cuePoint?: string = 9;
  protectedRegion?: bool = 10;
  /// B3z — as MarkerInsert.color (wins over `label`).
  color?: string = 11;
}

command addMarkers = 700 { markers: MarkerInsert[] = 1; } -> MarkerIds;
command updateMarkers = 701 [coalesce] { patches: MarkerPatch[] = 1; }
command deleteMarkers = 702 { ids: MarkerId[] = 1; }
command moveMarkers = 703 [coalesce] { ids: MarkerId[] = 1; delta: Time = 2; }

struct MarkerIds { ids: MarkerId[] = 1; }

family "Transport";

enum PlayRange { all = 0; workArea = 1; custom = 2; }
enum LoopMode { once = 0; loop = 1; pingPong = 2; }
enum PreviewResolution { full = 0; half = 1; third = 2; quarter = 3; auto = 4; }
enum FastPreview { off = 0; adaptive = 1; draft = 2; wireframe = 3; }
enum SeekMode { exact = 0; scrub = 1; }

/// Start playback of the active composition. The engine owns the clock; audio is the master clock when enabled.
command play = 800 [control] {
  /// 1 = real time; negative = reverse (J/K/L shuttle up to ±4).
  rate: f64 = 1;
  range: PlayRange = 2;
  custom?: TimeRange = 3;
  audio: bool = 4;
  /// Cache frames first, then play at full rate (RAM preview).
  cacheFirst: bool = 5;
  from?: Time = 6;
  /// With `cacheFirst`: stop once the range is stored instead of playing it, and put the playhead back where it was (Cache Work Area Now). A seek or a pause during the fill ends it with what is stored.
  cacheOnly: bool = 7;
}
command pause = 801 [control] { returnToStart: bool = 1; }
/// Move the playhead. Scrub mode may render at preview quality and plays audio scrub.
command seek = 802 [control, coalesce] { time: Time = 1; mode: SeekMode = 2; }
command step = 803 [control] { frames: i32 = 1; }
command setLoop = 804 [control] { mode: LoopMode = 1; }
command setPreviewQuality = 805 [control] {
  resolution: PreviewResolution = 1;
  fastPreview: FastPreview = 2;
  draft3d: bool = 3;
  motionBlur: bool = 4;
  /// Lowest resolution adaptive mode may fall to.
  adaptiveFloor: PreviewResolution = 5;
}
command setAudioPreview = 806 [control] { muted: bool = 1; volume: f64 = 2; scrubAudio: bool = 3; }
/// Which composition the clock and the viewport follow (the active comp tab). View state for the engine, not document state.
command setActiveComposition = 807 [control] { comp: ItemId = 1; }

enum ChannelView { rgb = 0; red = 1; green = 2; blue = 3; alpha = 4; rgbStraight = 5; }

/// A custom 3D view (customViews.ts CustomViewParams): the eye starts `distance` behind the point of interest along −z, orbits by yaw / pitch (degrees) and looks at it; the lens is the composition's default. Absent distance = 1.2 × the default focal length; absent poi = the comp centre on z = 0.
struct CustomView { yaw: f64 = 1; pitch: f64 = 2; distance?: f64 = 3; poi?: Vec3 = 4; }

/// Onion-skin ghosts (onionSkin.ts). Past is warm, future is cool, when `colorize`.
struct OnionSkin {
  before: u32 = 1;
  after: u32 = 2;
  step: u32 = 3;
  opacity: f64 = 4;
  colorize: bool = 5;
}

/// A viewport's render parameters: pixel size, zoom/pan, region of interest, channel, exposure.
command setViewport = 808 [control, coalesce] {
  viewport: u32 = 1;
  width: u32 = 2;
  height: u32 = 3;
  devicePixelRatio: f64 = 4;
  zoom: f64 = 5;
  pan: Vec2 = 6;
  regionOfInterest?: Rect = 7;
  channel: ChannelView = 8;
  exposure: f64 = 9;
  transparencyGrid: bool = 10;
  /// View LUT / display transform name ('' = project default).
  displayTransform: string = 11;
  /// Show a single layer (Layer panel) instead of the composition: the layer alone — eye on, un-soloed, a collapsed comp sealed, live at every time — untransformed at its source size, with none of what the comp does to it (placement, 3D, opacity, blend, mattes).
  layer?: LayerId = 12;
  /// With `layer`: false shows the untouched source — no masks, effects, paint, corner pin, glass or backdrop blur (the Layer panel's Render switch).
  layerRenderEffects: bool = 13;
  /// The 3D view this viewport renders (the editor's camera3dMode): absent, '' or 'active' = the composition's camera; an axis view (front, back, left, right, top, bottom); `camera:<layer>`; or 'custom' with `customView`. Every viewport has its own (a 2-up / 4-up pane).
  view?: string = 14;
  /// With view = 'custom': the view's own camera replaces the scene camera (depth of field and camera motion blur off, as in a custom view).
  customView?: CustomView = 15;
  /// A held time for this viewport (the Layer panel's own ruler): its frames render at this comp time instead of the session clock; absent = the clock.
  time?: Time = 16;
  /// With `layer` and `time`: the layer's source time at the held time (the Layer panel scrubs in layer time), overriding the layer's own retime.
  layerSourceTime?: Time = 17;
  /// Onion skins for this viewport. Absent = off. The engine draws the ghosts
  /// (transparent, tinted, farthest first) over the live frame while playback
  /// is stopped. Ignored on a layer view.
  onion?: OnionSkin = 18;
}
command closeViewport = 809 [control] { viewport: u32 = 1; }
command setCacheBudget = 810 [control] { ramMegabytes: u64 = 1; diskMegabytes: u64 = 2; diskPath: string = 3; }

enum PurgeKind { all = 0; ram = 1; disk = 2; undo = 3; images = 4; }

command purgeCache = 811 [control] { kind: PurgeKind = 1; }
/// Interaction hint: the UI is dragging, the engine may drop to draft quality until it ends.
command setInteracting = 812 [control] { interacting: bool = 1; }
/// The layers a viewport does not draw — editor state, not document state: the text layer being edited in place (the editor shows its text, so the engine must not draw it underneath). Replaces the viewport's previous set; empty = draw every layer. Hides the layer itself (as its eye switch would) in that viewport's frames only: exports, thumbnails and other viewports draw it. A control: no history, no revision.
command setViewportHiddenLayers = 813 [control] { viewport: u32 = 1; layers: LayerId[] = 2; }
/// Focus Mode — editor state, not document state: the layers the user is working inside. Every other layer of that viewport's frames is drawn as a dim reference (12 % of its opacity); exports, thumbnails and other viewports are untouched. Replaces the viewport's previous set; empty = no focus, every layer draws as authored. A control: no history, no revision.
command setViewportFocus = 814 [control] { viewport: u32 = 1; layers: LayerId[] = 2; }

/// B4 — what the overlay geometry push carries for each subscribed layer (FrameGeometry, 95_frames).
enum OverlayKind { transform = 0; bounds = 1; motionPath = 2; rig = 3; textBox = 4; scene3d = 8; }
/// B4 round 5 — one overlay's share of a subscription (setOverlayGeometry `groups`): its layers get ITS kinds, not every kind another overlay asked for.
struct OverlayRequest { layers: LayerId[] = 1; kinds: OverlayKind[] = 2; }
/// B4 — subscribe a viewport's overlays to FRAME-SYNCHRONOUS geometry (docs/TS_ENGINE_REMOVAL.md "Gaps"): from its next frame on, every FrameReady of `viewport` is preceded on the frame channel by FrameGeometry messages for `layers`, evaluated at that frame's own time and revision — the world matrices, drawn boxes, motion paths and text boxes the selection outline, gizmos and motion path draw, instead of a query per played frame. Replaces the viewport's previous subscription; no layers or no kinds = unsubscribe. Layers that do not exist are skipped. A control: no history, no revision.
/// B4 round 5: `groups` — per-overlay layer × kind requests; a layer gets the union of the kinds of every group naming it (and `kinds` when `layers` names it). `views` — the view modes (`active`, `camera:<id>`, an ortho view, a custom view id) whose resolved VIEW CAMERA each frame carries (FrameGeometry.views). The subscription is empty only when layers × kinds, every group and `views` are.
/// B4 round 5: `rig` — what the `rig` kind resolves beyond the pose (OverlayRig): the focus pin's motion path, the focus bone's weights, and the puppet tool's pinless authoring mesh.
command setOverlayGeometry = 1771 [control] { viewport: u32 = 1; layers: LayerId[] = 2; kinds: OverlayKind[] = 3; groups: OverlayRequest[] = 10; views: string[] = 11; rig?: OverlayRigOptions = 20; }
/// B4 round 5 — the rig overlay's editor-side focus (setOverlayGeometry `rig`).
struct OverlayRigOptions {
  /// The selected puppet pin: its Position trajectory and keys ride OverlayRig.pinPath / pinKeys ('' = none).
  pin: string = 1;
  /// The selected bone: its bind weight per vertex rides OverlayRig.weights ('' = none).
  bone: string = 2;
  /// The Puppet Pin tool's mesh (nodeRestMesh `authoringPreview`): before the first pin exists the layer shows the mesh the first pin will be placed on (an image / SVG layer's alpha outline), and a layer with no rig still gets one. False = the rig's own mesh (what renders), none without a rig.
  authoring: bool = 3;
}
