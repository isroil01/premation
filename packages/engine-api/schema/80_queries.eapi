// Queries: read without changing anything. They answer at the revision in the
// Response. Query ids: 1000–1199.

family "Model";

/// A project item as the mirror holds it.
struct ItemInfo {
  id: ItemId = 1;
  kind: ItemKind = 2;
  name: string = 3;
  parent?: ItemId = 4;
  label: u32 = 5;
  comment: string = 6;
  /// Footage fields.
  path: string = 7;
  missing: bool = 8;
  width: u32 = 9;
  height: u32 = 10;
  duration: Time = 11;
  frameRate?: Rational = 12;
  hasVideo: bool = 13;
  hasAudio: bool = 14;
  hasAlpha: bool = 15;
  interpretation?: Interpretation = 16;
  proxyPath: string = 17;
  proxyEnabled: bool = 18;
  tags: string[] = 19;
  codec: string = 20;
  audioChannels: u32 = 21;
  audioSampleRate: u32 = 22;
  colorProfile: string = 23;
  fileBytes: u64 = 24;
  /// B4 — what a FOOTAGE item holds: a still image, video or audio (`none` for compositions, folders, solids and placeholders). What the Inspector's pickers (a still image for a sky, a sprite, a height map) and the proxy row filter on.
  mediaType: MediaType = 124;
  /// B4 — the import probe looked for an alpha channel: `hasAlpha` false with this false means "never probed", not "opaque" (the Alpha interpretation control stays offered).
  alphaProbed: bool = 125;
  /// B4 — the import probe looked for an audio stream: `hasAudio` false on video with this false means "never probed".
  audioProbed: bool = 126;
}

struct CompInfo {
  id: ItemId = 1;
  settings: CompSettings = 2;
  /// Layer ids, top of the stack first.
  layers: LayerId[] = 3;
  markers: Marker[] = 4;
  /// B3z — the composition's cut transitions, in the order they were added.
  transitions: Transition[] = 5;
}

/// B4 — what a layer holds of an SVG document (LayerInfo.svg).
enum SvgRole { none = 0; layer = 1; converted = 2; }

/// The layer header the timeline and layer panel draw (no property tree).
struct LayerInfo {
  id: LayerId = 1;
  comp: ItemId = 2;
  kind: LayerKind = 3;
  name: string = 4;
  parent?: LayerId = 5;
  source?: ItemId = 6;
  switches: LayerSwitches = 7;
  timing: LayerTiming = 8;
  blendMode: BlendMode = 9;
  matte: TrackMatte = 10;
  /// Child layer ids for group layers, in stack order.
  children: LayerId[] = 11;
  hasVideo: bool = 12;
  hasAudio: bool = 13;
  /// Layer markers.
  markers: Marker[] = 14;
  comment: string = 15;
  /// B4 — for a layer provided by a plugin layer kind: the kind id `<pluginId>.<kindId>` (what the Inspector keys its sections on) — a `generator` layer, or a custom plugin layer (`pluginLayer:<kind>` component) whose `kind` reads as the shape it draws. '' otherwise.
  generator: string = 16;
  /// B4 — the layer's Pinned properties (the Inspector's Pinned tab), in the order they were pinned: the editor's track names (`x`, `opacity`, `effect.<id>.<param>`) as stored in the document (`__pinnedProps`).
  pinned: string[] = 17;
  /// B4 — how many effects the layer's effect stack holds (the `effects` group's children, disabled ones included): what a collapsed timeline row needs to draw the fx switch without loading the property tree.
  effectCount: u32 = 18;
  /// B4 — a shape layer's primitive (`rect`, `ellipse`, `star`, `polygon`, `triangle`, `line`, `arrow`, `heart`, `cross`, `diamond`, `crescent`: the stored `shapeType`), '' for a drawn path or any other layer. What the Layers tree's glyph narrows on (`kind` folds star / triangle into `polygon`).
  shapeType: string = 118;
  /// B4 — the plugin that GENERATED this layer and will overwrite it on its next run (`__ownedByPlugin`), '' for a layer the user owns. The Layers tree marks it.
  managedBy: string = 119;
  /// B4 — for the root group of an INSERTED motion-graphics element: the library item it came from (`__mographId`), '' otherwise. The Inspector's fill-in-the-blanks section keys on it.
  mographId: string = 120;
  /// B4 — `layer`: an SVG layer that stores its document (getSvgDocument reads it; Convert to Editable Shapes); `converted`: a group converted from one that still retains the original source (Revert to Original SVG); `none` otherwise.
  svg: SvgRole = 920;
  /// B4 — a custom plugin layer's stored schema version (`__schemaVersion` on its `pluginLayer:<kind>` component; 1 when the record has none): what decides the Inspector's needs-migration / downgrade state. Absent for a layer that is not a custom plugin layer.
  pluginSchemaVersion?: u32 = 921;
}

/// B4 — one dimension's own expression on an UNSEPARATED vector (setExpression `member`).
struct MemberExpression {
  member: u32 = 1;
  source: string = 2;
  enabled: bool = 3;
  error: string = 4;
}

enum PropertyKind { property = 0; group = 1; indexedGroup = 2; }

/// One node of a layer's property tree (AE's Property / PropertyGroup).
struct PropertyInfo {
  path: PropPath = 1;
  name: string = 2;
  matchName: string = 3;
  kind: PropertyKind = 4;
  valueType: ValueType = 5;
  animatable: bool = 6;
  animated: bool = 7;
  dimensions: u32 = 8;
  separated: bool = 9;
  enabled: bool = 10;
  /// The static value (not animated) — the value at the query time otherwise.
  value?: Value = 11;
  defaultValue?: Value = 12;
  min?: f64 = 13;
  max?: f64 = 14;
  softMin?: f64 = 15;
  softMax?: f64 = 16;
  /// Allowed values for choice properties.
  choices: string[] = 17;
  unit: string = 18;
  expression: string = 19;
  expressionEnabled: bool = 20;
  expressionError: string = 21;
  keyframeCount: u32 = 22;
  /// Child paths for groups, in order.
  children: PropPath[] = 23;
  /// Hidden in the default UI (AE's hidden/advanced params).
  hidden: bool = 24;
  /// B4 — per-dimension expressions: when the dimensions of a multi-dimensional property do NOT all carry the same expression (source and enabled), every dimension that has one, in member order; `expression` / `expressionEnabled` / `expressionError` then describe dimension 0 only. Empty when the property has one expression for every dimension, or none.
  memberExpressions: MemberExpression[] = 25;
}

struct KeyframeSet {
  prop: PropRef = 1;
  keyframes: Keyframe[] = 2;
}

struct PropertyValue {
  prop: PropRef = 1;
  value: Value = 2;
}

/// Whole-document snapshot: what the UI mirror is built from after Welcome or documentReset.
struct DocumentSnapshot {
  revision: Revision = 1;
  projectPath: string = 2;
  dirty: bool = 3;
  settings: ProjectSettings = 4;
  items: ItemInfo[] = 5;
  comps: CompInfo[] = 6;
  layers: LayerInfo[] = 7;
  /// Present only when requested (includeProperties): every layer's property tree with static values.
  propertyTrees: PropertyTree[] = 8;
  keyframes: KeyframeSet[] = 9;
  renderQueue: RenderItemInfo[] = 10;
  /// F2 — the guide settings as saved (a JSON object; defaults omitted, `{}` when all default). setGuides patches it.
  guides: string = 11;
  swatches: Swatch[] = 12;
  materials: LibraryMaterial[] = 13;
  /// F2 — the project's motion-blur record (setMotionBlur).
  motionBlur: MotionBlurSettings = 713;
  /// F2 — the project's colour management (setColorManagement).
  colorManagement: ColorManagementSettings = 714;
}

/// The document as saveProject would write it: a .motion project's JSON, UTF-8.
struct ExportedDocument { document: bytes = 1; }

struct RenderItemInfo {
  id: RenderItemId = 1;
  comp: ItemId = 2;
  settings: RenderSettings = 3;
  status: RenderStatus = 4;
  queued: bool = 5;
  progress: f64 = 6;
  error: string = 7;
}

query getDocument = 1000 { includeProperties: bool = 1; includeKeyframes: bool = 2; } -> DocumentSnapshot;
/// F2 — the whole project document at the answer's revision, exactly as saveProject writes it (cloud upload, versions, templates and export read it here instead of capturing a copy in the page). Byte order of keys is the engine's; parse it, do not compare bytes across engines.
query exportDocument = 1088 {} -> ExportedDocument;
query getComposition = 1001 { comp: ItemId = 1; } -> CompositionDetails;
query getLayers = 1002 { layers: LayerId[] = 1; } -> LayerDetails;
/// The property tree under `path` ('' = whole layer) to `depth` levels (0 = unlimited), values at `time`.
query getPropertyTree = 1003 { layer: LayerId = 1; path: PropPath = 2; depth: u32 = 3; time?: Time = 4; } -> PropertyTree;
/// Values at `time`. evaluated=false returns the pre-expression value.
query getPropertyValues = 1004 { props: PropRef[] = 1; time: Time = 2; evaluated: bool = 3; } -> PropertyValues;
/// Sample one property densely (graph editor value/speed graphs, motion paths).
query sampleProperty = 1005 { prop: PropRef = 1; range: TimeRange = 2; samples: u32 = 3; speed: bool = 4; } -> PropertySamples;
query getKeyframes = 1006 { props: PropRef[] = 1; range?: TimeRange = 2; } -> KeyframeSets;
query getMotionPath = 1007 { layer: LayerId = 1; range: TimeRange = 2; samples: u32 = 3; } -> PropertySamples;
query getMarkers = 1008 { owner: MarkerOwner = 1; range?: TimeRange = 2; } -> MarkerList;
/// Serialize layers (with the items they reference) for the clipboard; pasteLayers consumes it.
query copyLayers = 1009 { layers: LayerId[] = 1; } -> DocumentFragment;
/// B4 — Edit ▸ Copy of KEYFRAMES in API form: the whole keys `keys` names (every dimension of each — After Effects copies a key, not a member), grouped per property in the order the ids first name them, each set's keys in time order at their composition times. `pasteKeyframes` puts a set onto any layer's property of the same path (the editor lands the earliest copied key at the playhead, spacing kept). Unknown ids are skipped: none found answers an empty clipboard.
query copyKeyframes = 1889 { keys: KeyframeId[] = 1; } -> KeyframeSets;
/// B4 — a layer's stored MEMBER keyframe lists: every animated member track (a keyed track — `x` keyed apart from `y` on an unseparated Position, a colour channel, an effect param, a track outside the catalog — then the expression-only ones), in the engine's order, with its keyframe records in the stored form the keyframe assistants (The Smoother, The Wiggler, the motion editor) transform. The API's own key lists are per PROPERTY (§3.3); these are the assistants' input, written back as `setKeyframes` per property. `members` narrows to those tracks (empty = all).
query getMemberKeyframes = 1893 { layer: LayerId = 1; members: string[] = 2; } -> MemberTracks;
/// B4 — Edit ▸ Copy of EFFECTS in API form: the layer's effects `effects` names (`effects/<id>`; empty = the whole stack), in stack order, captured as `pasteEffects` takes them — a JSON array of `{effect: <the stored effect: type, params, enabled, opacity, maskId, labelColor, …>, tracks: {<param suffix>: Keyframe[]}}` (stored keyframe records on the layer's keyframe axis; suffix '' = the legacy single-scalar track). Two captures of the same effect compare equal as strings until it changes (the editor's "still as copied" test). Unknown effect paths are skipped.
query copyEffects = 1890 { layer: LayerId = 1; effects: PropPath[] = 2; } -> CopiedEffects;
/// B4 — what a document-wide text search over layers matches besides their headers (the Layers panel's Effects / Expressions filters): per layer, its effects' match names in stack order and the source of every expression it carries (enabled or not, in the engine's order). `layers` narrows (empty = every layer of every composition, in `findLayers` order); unknown ids are skipped. The mirror loads property trees on demand, never wholesale — this answers the whole document in one round trip.
query getSearchFacts = 1894 { layers: LayerId[] = 1; } -> SearchFactsList;
struct LayerSearchFacts { layer: LayerId = 1; effects: string[] = 2; expressions: string[] = 3; }
struct SearchFactsList { layers: LayerSearchFacts[] = 1; }

/// B4 — one member track (getMemberKeyframes).
struct MemberTrack {
  /// The stored track name (`x`, `scaleX`, `opacity`, `effect.<id>.<param>`, …).
  member: string = 1;
  /// The API property that owns the member ('' outside the catalog) and its index among the property's members.
  path: PropPath = 2;
  index: u32 = 3;
  /// The keyframe records as stored, JSON: `[{t: keyframe-axis seconds, value: stored units, easing?, bezier?, si?, so?, spatialInterp?, continuous?, roving?, id?, label?}]` ('[]' for an expression-only member).
  keyframes: string = 4;
  count: u32 = 5;
  /// The member carries an expression (enabled or not).
  hasExpression: bool = 6;
}
struct MemberTracks { tracks: MemberTrack[] = 1; }

/// B4 — copyEffects' answer.
struct CopiedEffects {
  /// The captures as JSON (see copyEffects); '[]' when none.
  effects: string = 1;
  /// The `effects/<id>` path of each capture, in the same order.
  paths: PropPath[] = 2;
}

struct CompositionDetails { comp: CompInfo = 1; layers: LayerInfo[] = 2; }
struct LayerDetails { layers: LayerInfo[] = 1; }
struct PropertyTree { layer: LayerId = 1; nodes: PropertyInfo[] = 2; }
struct PropertyValues { values: PropertyValue[] = 1; }
struct KeyframeSets { sets: KeyframeSet[] = 1; }
struct MarkerList { markers: Marker[] = 1; }

/// Dense samples: `values` holds `dimensions` numbers per time.
struct PropertySamples {
  times: f64[] = 1;
  values: f64[] = 2;
  dimensions: u32 = 3;
  /// Speed (units/s) per time when requested.
  speeds: f64[] = 4;
}

family "Media";

struct WaveformPeaks {
  /// Interleaved min/max per bucket per channel.
  peaks: f32[] = 1;
  channels: u32 = 2;
  buckets: u32 = 3;
  /// RMS per bucket (loudness display), optional.
  rms: f32[] = 4;
}

struct FontInfo {
  family: string = 1;
  style: string = 2;
  postScriptName: string = 3;
  weight: f64 = 4;
  italic: bool = 5;
  variableAxes: FontAxisInfo[] = 6;
  /// Scripts covered ('Latn', 'Hang', 'Arab', …).
  scripts: string[] = 7;
  path: string = 8;
}

struct FontAxisInfo { tag: string = 1; name: string = 2; min: f64 = 3; max: f64 = 4; defaultValue: f64 = 5; }

query getWaveform = 1020 { layer?: LayerId = 1; item?: ItemId = 2; range: TimeRange = 3; buckets: u32 = 4; } -> WaveformPeaks;
query listFonts = 1021 { query: string = 1; } -> FontList;
query getItems = 1022 { items: ItemId[] = 1; } -> ItemDetails;
/// B4 — the SVG document a layer stores (LayerInfo.svg): an SVG layer's file name, intrinsic size, view box, capability scan, playback mode and markup, or a converted group's retained source. `role` none (every other field empty) for any other layer.
query getSvgDocument = 1891 { layer: LayerId = 1; } -> SvgDocument;
/// B4 — the Cryptomatte ID set a footage item's EXR carries (layer names and their objects, from the file's manifest): what Layer ▸ ID Matte lists. Empty when the file has none or was not decoded yet. `unsupported` where the engine does not decode EXR (the C++ engine, until its media decode reads EXR).
query getCryptomatte = 1892 { item: ItemId = 1; } -> CryptomatteInfo;
/// A frame thumbnail of an item or layer (project panel, timeline filmstrip). Encoded image bytes.
query getThumbnail = 1023 { item?: ItemId = 1; layer?: LayerId = 2; time: Time = 3; maxSize: u32 = 4; } -> Thumbnail;

struct FontList { fonts: FontInfo[] = 1; }
struct ItemDetails { items: ItemInfo[] = 1; }
struct Thumbnail { width: u32 = 1; height: u32 = 2; format: string = 3; data: bytes = 4; }
/// B4 — getSvgDocument's answer.
struct SvgDocument {
  role: SvgRole = 1;
  fileName: string = 2;
  intrinsicWidth: f64 = 3;
  intrinsicHeight: f64 = 4;
  viewBox?: Rect = 5;
  /// The import's capability scan (SvgCapabilities) as JSON: paths, text, gradients, filters, SMIL / CSS animation, …
  capabilities: string = 6;
  /// Re-rasterised at the playhead (SMIL / CSS) rather than a static texture.
  livePlayback: bool = 7;
  /// The original markup (what Revert to Original SVG restores).
  sourceMarkup: string = 8;
  /// The sanitised markup the layer renders, under `sanitizePolicy` (the editor re-sanitises an older policy's from the source).
  sanitizedMarkup: string = 9;
  sanitizePolicy: u32 = 10;
}
/// B4 — one Cryptomatte layer of an EXR (its channel prefix, e.g. "CryptoObject") and its objects' names, manifest order.
struct CryptomatteLayerInfo { name: string = 1; objects: string[] = 2; }
struct CryptomatteInfo { layers: CryptomatteLayerInfo[] = 1; }

family "Catalog";

struct EffectParamInfo {
  name: string = 1;
  matchName: string = 2;
  valueType: ValueType = 3;
  animatable: bool = 4;
  defaultValue?: Value = 5;
  min?: f64 = 6;
  max?: f64 = 7;
  softMin?: f64 = 8;
  softMax?: f64 = 9;
  choices: string[] = 10;
  unit: string = 11;
  group: string = 12;
}

struct EffectInfo {
  matchName: string = 1;
  displayName: string = 2;
  category: string = 3;
  gpu: bool = 4;
  /// 'builtin' or the plugin id.
  provider: string = 5;
  params: EffectParamInfo[] = 6;
  supportsFloat: bool = 7;
  audio: bool = 8;
}

query listEffects = 1040 { category: string = 1; } -> EffectCatalog;
/// Which group match names can be added under a parent path (the Add ▸ menus).
query listGroupTypes = 1041 { layer: LayerId = 1; parent: PropPath = 2; } -> GroupTypeList;
query listPresets = 1042 { category: string = 1; } -> PresetList;
/// B4 — Save as Preset: the layer's animation as a preset BODY, in the preset format `applyPreset` replays (the Motion Presets panel stores it in the user's library under a name). Keyframe tracks rebased to t = 0 and converted out of pixels into the units each property travels in (position → comp fractions, type metrics → font sizes, against the layer's own composition), text animators, the effect stack in the preset's own id namespace (`fx0`, … with its `effect.<id>.*` tracks re-pointed) and enabled expressions. `notFound` for no such layer.
query capturePreset = 1888 { layer: LayerId = 1; } -> CapturedPreset;
query getCapabilities = 1043 {} -> Capabilities;
/// G1 — the native SDK plugins the engine process found (docs/PLUGIN_SDK.md), in load order: loaded, disabled for this session, failed (with why), or quarantined (it ended the engine last time; setPluginEnabled retries it). The TypeScript engine hosts no native plugins: an empty list.
query listPlugins = 1086 {} -> PluginList;
/// G1 — a native plugin effect's parameter UI at `time` (UPDATE_PARAMS_UI: which params are enabled, hidden or renamed for the current values). A builtin effect answers every param enabled and visible under its catalog name. `notFound` for no such layer or effect.
query getEffectUi = 1087 { layer: LayerId = 1; effect: PropPath = 2; time?: Time = 3; } -> EffectUi;

enum PluginStatus { loaded = 0; disabled = 1; failed = 2; quarantined = 3; }

struct PluginInfo {
  id: string = 1;
  name: string = 2;
  version: string = 3;
  vendor: string = 4;
  /// The SDK version the plugin was built against (`major.minor`).
  sdk: string = 5;
  status: PluginStatus = 6;
  /// Why a plugin failed or was quarantined ('' otherwise).
  error: string = 7;
  /// The match names of its effects.
  effects: string[] = 8;
  /// Any of its effects renders on the GPU (SMART_RENDER_GPU).
  gpu: bool = 9;
}
struct PluginList { plugins: PluginInfo[] = 1; }

struct EffectParamUi {
  /// The param's property key under the effect (`p3`).
  key: string = 1;
  name: string = 2;
  enabled: bool = 3;
  hidden: bool = 4;
}
struct EffectUi { params: EffectParamUi[] = 1; }

struct EffectCatalog { effects: EffectInfo[] = 1; }
struct GroupTypeInfo { matchName: string = 1; displayName: string = 2; category: string = 3; }
struct GroupTypeList { types: GroupTypeInfo[] = 1; }
struct PresetInfo { id: string = 1; name: string = 2; category: string = 3; description: string = 4; }
struct PresetList { presets: PresetInfo[] = 1; }
/// B4 — capturePreset's answer.
struct CapturedPreset {
  /// The preset body as JSON: `{tracks: [{prop, unit?, keyframes: [{t, value, easing?, bezier?, …}]}], animators?, requires?: 'text', effects?: [{id, type, params?}], expressions?: [{prop, expr}]}` — every field of an AnimationPreset but its name and folder. Track names are the stored (legacy) prop paths the preset format uses, not API paths. '{}' when `empty`.
  preset: string = 1;
  /// Nothing to save: no keyframes, animators, effects or enabled expressions on the layer.
  empty: bool = 2;
}

struct Capabilities {
  gpuAdapter: string = 1;
  gpuBackend: string = 2;
  vramBytes: u64 = 3;
  maxTextureSize: u32 = 4;
  hardwareDecode: string[] = 5;
  exportFormats: string[] = 6;
  colorManagement: bool = 7;
  float32: bool = 8;
  pluginApis: string[] = 9;
  expressionEngines: string[] = 10;
  cpuThreads: u32 = 11;
}

family "Interaction";

enum HitMode { topmost = 0; all = 1; }
enum BoundsSpace { comp = 0; layer = 1; viewport = 2; }

struct LayerBounds {
  layer: LayerId = 1;
  /// Axis-aligned bounds in the requested space.
  bounds: Rect = 2;
  /// The four corners of the transformed layer box (x0,y0 … x3,y3) in that space.
  corners: f64[] = 3;
}

struct LayerTransform {
  layer: LayerId = 1;
  /// Column-major 4×4 layer→comp matrix at the query time.
  matrix: f64[] = 2;
  anchor: Vec3 = 3;
}

struct GlyphBox { index: u32 = 1; line: u32 = 2; box: Rect = 3; baseline: f64 = 4; advance: f64 = 5; }

query hitTest = 1060 { comp: ItemId = 1; time: Time = 2; point: Vec2 = 3; mode: HitMode = 4; includeLocked: bool = 5; } -> HitResult;
query getLayerBounds = 1061 { layers: LayerId[] = 1; time: Time = 2; space: BoundsSpace = 3; includeEffects: bool = 4; viewport?: u32 = 5; } -> LayerBoundsList;
query getLayerTransforms = 1062 { layers: LayerId[] = 1; time: Time = 2; } -> LayerTransformList;
/// Text layout: how a text layer's lines measure (B4: the render box, the selection box, the wrap, the paragraph box, where the line block sits in the layer). The STORED style is measured (animated values at their base, as Convert / Box Auto-Size hold the text still) with `overrides` winning — a "where would the lines sit if…" before a write. `time` is reserved for evaluated layouts (glyph boxes for in-viewport editing). `invalidArgument` for a layer with no text; `unsupported` where the engine cannot measure (no fonts: the headless engine, a jsdom page) or the style is outside its text port (the message says which).
query getTextLayout = 1063 { layer: LayerId = 1; time: Time = 2; overrides?: TextLayoutOverrides = 802; } -> TextLayout;
/// Evaluate an expression without storing it (expression editor preview). `member`: the dimension the draft drives (as setExpression's — `value` is that member's own value, and the answer is that member's); absent = the property's first member, a vector result whole. On `text/sourceText` the draft is a Source Text expression: the answer is `text` (no `value`).
query evaluateExpression = 1064 { prop: PropRef = 1; time: Time = 2; source: string = 3; member?: u32 = 4; } -> ExpressionEvaluation;
/// Pixel values under a point of a viewport (Info panel, eyedropper), in working space.
query readPixels = 1065 { viewport: u32 = 1; region: Rect = 2; } -> PixelSamples;
query findLayers = 1066 { comp?: ItemId = 1; name: string = 2; kinds: LayerKind[] = 3; effect: string = 4; } -> LayerList;
/// What a layer/item depends on and what depends on it (flowchart, expression references, precomp nesting).
query getDependencies = 1067 { layer?: LayerId = 1; item?: ItemId = 2; } -> Dependencies;

struct HitResult { layers: LayerId[] = 1; }
struct LayerBoundsList { bounds: LayerBounds[] = 1; }
struct LayerTransformList { transforms: LayerTransform[] = 1; }
struct TextLayout {
  /// Per-glyph boxes for in-viewport editing — not filled yet (both engines answer empty; the text-edit overlay still measures in the page).
  glyphs: GlyphBox[] = 1;
  /// Lines as laid out (after the paragraph wrap).
  lines: u32 = 2;
  /// The SELECTION box: the font-metric box of the laid-out lines, relative to the layer origin (x = −advance / 2), before the Character panel's scale. Stable while typing (font metrics, not ink).
  box: Rect = 3;
  /// B4 — the RENDER box (the texture the text rasterises into, padding included): measureTextSize's {w, h}.
  size: Vec2 = 803;
  /// B4 — the content as laid out: paragraph text with each soft wrap as '\n' (one space replaced per wrap, so character indices keep); point text unchanged.
  wrapped: string = 804;
  /// B4 — the wrapped line numbers that end in a SOFT wrap (not a typed return).
  softBreaks: u32[] = 805;
  /// B4 — the paragraph box; absent for point text (and text on a path).
  paragraph?: ParagraphLayout = 806;
  /// B4 — where the line block sits in the layer, local units after the Character panel's scale: the x its lines start / centre / end at (by alignment and first-paragraph direction, indents included) and its vertical offset from the centred position. What a Point ⇄ Paragraph conversion holds still (the difference of two answers; the render padding cancels).
  lineBlock: Vec2 = 807;
  /// B4 — the Character panel's whole-layer glyph scale (horizontal / vertical scale, × 0.65 for super / subscript).
  styleScale: Vec2 = 808;
  /// B4 — the text rides a mask path (point text: no box).
  onPath: bool = 809;
  /// B4 — the style measured (overrides applied): what a Fit Text to Box bake multiplies.
  fontSize: f64 = 810;
  letterSpacing: f64 = 811;
  paragraphSpacing: f64 = 812;
}
/// B4 — getTextLayout's hypothetical style: each set field replaces the stored one for the measurement only.
struct TextLayoutOverrides {
  content?: string = 1;
  /// 0 = point text.
  boxWidth?: f64 = 2;
  /// 0 = no authored height (auto height).
  boxHeight?: f64 = 3;
  /// 'off' | 'height' | 'fit'.
  boxAutoSize?: string = 4;
  fontSize?: f64 = 5;
  letterSpacing?: f64 = 6;
  paragraphSpacing?: f64 = 7;
}
/// B4 — a paragraph text layer's box as it measures (measureParagraphBox + readParagraphBox).
struct ParagraphLayout {
  boxWidth: f64 = 1;
  /// The box's height: authored when fixed, the text's own when auto.
  boxHeight: f64 = 2;
  fixedHeight: bool = 3;
  /// Text runs past the bottom of a fixed box (AE's red overflow mark).
  overflow: bool = 4;
  /// Fit Text to Box's type scale; 1 otherwise.
  fitScale: f64 = 5;
  /// The height the lines occupy as drawn (after the fit scale), px.
  contentHeight: f64 = 6;
  lineCount: u32 = 7;
  /// Lines actually drawn (the rest are clipped by a fixed box).
  visibleLines: u32 = 8;
  /// How far the line block sits below where it would sit centred on the origin, px (a fixed box aligning its lines top / bottom; an anchored auto-height box).
  lineOffsetY: f64 = 9;
  /// The resolved auto-size mode: 'off' | 'height' | 'fit' (no stored height is auto height whatever the mode says).
  autoSize: string = 10;
  /// 'top' | 'center' | 'bottom'.
  verticalAlign: string = 11;
  /// The STORED box height (0 = none): an auto-height box keeps the top edge of a box this tall.
  storedHeight: f64 = 12;
}
struct ExpressionEvaluation { value?: Value = 1; diagnostics: ExpressionDiagnostic[] = 2; text?: SourceTextPreview = 3; }
/// What a draft Source Text expression evaluates to (evaluateExpression on `text/sourceText`): the text, the layer-wide style keys it overrides (the Source Text result's names: `fontSize`, `fill`, `tracking`, …, in declaration order), how many character ranges it styles and the distinct style keys those ranges set (first-seen order).
struct SourceTextPreview { text: string = 1; styleKeys: string[] = 2; ranges: u32 = 3; rangeKeys: string[] = 4; }
struct PixelSamples { width: u32 = 1; height: u32 = 2; rgba: f32[] = 3; }
struct Dependencies { uses: PropRef[] = 1; usedBy: PropRef[] = 2; items: ItemId[] = 3; }

family "Status";

struct HistoryEntry { label: string = 1; origin: Origin = 2; }

struct HistoryState {
  entries: HistoryEntry[] = 1;
  position: u32 = 2;
  canUndo: bool = 3;
  canRedo: bool = 4;
  gestureOpen: bool = 5;
  limit: u32 = 6;
}

struct RenderStats {
  gpuFrameMs: f64 = 1;
  cpuFrameMs: f64 = 2;
  fps: f64 = 3;
  droppedFrames: u64 = 4;
  vramBytes: u64 = 5;
  ramCacheBytes: u64 = 6;
  diskCacheBytes: u64 = 7;
  cacheHitRate: f64 = 8;
  decodeMs: f64 = 9;
}

struct LayerError {
  layer: LayerId = 1;
  /// Where it failed: 'effect', 'decode', 'plugin', 'expression', 'text', 'mask', …
  stage: string = 2;
  message: string = 3;
  path?: PropPath = 4;
}

enum JobStatus { queued = 0; running = 1; done = 2; failed = 3; cancelled = 4; }

struct JobInfo {
  id: JobId = 1;
  kind: string = 2;
  status: JobStatus = 3;
  progress: f64 = 4;
  message: string = 5;
  /// The finished job's summary, JSON (kind-specific, ENGINE_API.md §4.9); '' until done.
  result: string = 705;
  /// Whether its result was applied (false while running, with apply=false, or when it changes nothing).
  applied: bool = 706;
}

query getHistory = 1080 {} -> HistoryState;
query getRenderStats = 1081 {} -> RenderStats;
query getLayerErrors = 1082 { comp?: ItemId = 1; } -> LayerErrorList;
query getJobs = 1083 {} -> JobList;
query getRenderQueue = 1084 {} -> RenderQueueState;
/// The command log since `fromRevision` (B5 replay, bug reports).
query getCommandLog = 1085 { fromRevision: Revision = 1; } -> CommandLog;

struct LayerErrorList { errors: LayerError[] = 1; }
struct JobList { jobs: JobInfo[] = 1; }
struct RenderQueueState { items: RenderItemInfo[] = 1; }
struct CommandLog { records: LogRecord[] = 1; }
