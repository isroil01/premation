// Layers: creation, structure, switches, parenting, mattes, and layer time
// (the timeline bars). Command ids: 200–399.

family "Layers";

enum LayerKind {
  null = 0; solid = 1; shape = 2; rectangle = 3; ellipse = 4; polygon = 5; path = 6; text = 7;
  image = 8; video = 9; audio = 10; svg = 11; precomp = 12; camera = 13; light = 14; group = 15;
  component = 16; particle = 17; model3d = 18;
  /// A plugin generator layer (the plugin id is in `source` or init props).
  generator = 19;
  adjustment = 20;
  /// Image sequence footage.
  sequence = 21;
}

enum LayerQuality { best = 0; draft = 1; wireframe = 2; }
enum FrameBlend { off = 0; frameMix = 1; pixelMotion = 2; }
enum AutoOrient { off = 0; alongPath = 1; towardsCamera = 2; towardsPointOfInterest = 3; }
enum MatteMode { none = 0; alpha = 1; alphaInverted = 2; luma = 3; lumaInverted = 4; }

struct LayerSwitches {
  visible: bool = 1;
  audioEnabled: bool = 2;
  solo: bool = 3;
  locked: bool = 4;
  shy: bool = 5;
  /// Collapse transformations (precomp) / continuously rasterize (vector).
  collapse: bool = 6;
  quality: LayerQuality = 7;
  effectsEnabled: bool = 8;
  motionBlur: bool = 9;
  adjustment: bool = 10;
  threeD: bool = 11;
  guide: bool = 12;
  frameBlend: FrameBlend = 13;
  autoOrient: AutoOrient = 14;
  preserveTransparency: bool = 15;
  /// Colour label index (0 = none).
  label: u32 = 16;
}

struct LayerSwitchesPatch {
  visible?: bool = 1;
  audioEnabled?: bool = 2;
  solo?: bool = 3;
  locked?: bool = 4;
  shy?: bool = 5;
  collapse?: bool = 6;
  quality?: LayerQuality = 7;
  effectsEnabled?: bool = 8;
  motionBlur?: bool = 9;
  adjustment?: bool = 10;
  threeD?: bool = 11;
  guide?: bool = 12;
  frameBlend?: FrameBlend = 13;
  autoOrient?: AutoOrient = 14;
  preserveTransparency?: bool = 15;
  label?: u32 = 16;
}

/// A layer's place in time. All comp time except sourceOffset.
struct LayerTiming {
  inPoint: Time = 1;
  outPoint: Time = 2;
  /// Comp time at which source time 0 plays (AE Start Time).
  startTime: Time = 3;
  /// Time stretch, 1 = 100 %. Negative = reversed.
  stretch: f64 = 4;
  timeRemapEnabled: bool = 5;
  retime: RetimeMode = 6;
}

struct LayerTimingPatch {
  layer: LayerId = 1;
  inPoint?: Time = 2;
  outPoint?: Time = 3;
  startTime?: Time = 4;
  stretch?: f64 = 5;
}

struct TrackMatte {
  /// The matte source layer (AE 2023 matte-by-reference; any layer, not only the one above). B3z: absent with a mode other than none = the classic positional matte (the layer directly above in the stack; stored without a source).
  layer?: LayerId = 1;
  mode: MatteMode = 2;
}

/// Create a layer. `index` 0 is the top of the stack; absent = above the first selected layer is the UI's job, the engine uses the top.
command createLayer = 200 {
  comp: ItemId = 1;
  kind: LayerKind = 2;
  name?: string = 3;
  /// Footage / composition item for footage, precomp and sequence layers.
  source?: ItemId = 4;
  parent?: LayerId = 5;
  index?: u32 = 6;
  inPoint?: Time = 7;
  outPoint?: Time = 8;
  startTime?: Time = 9;
  /// Property values to set at creation (transform/position, shape/size, text/sourceText, …).
  init: PropertyInit[] = 10;
  /// Plugin generator id / effect match name for kind=generator.
  generator?: string = 11;
} -> LayerRef;
/// Delete layers. Children are un-parented keeping their world transform. Undo restores the layers, their properties, keyframes, effects, parenting and stack position exactly (same ids).
command deleteLayers = 201 { layers: LayerId[] = 1; }
/// Duplicate layers directly above each original. Returns the new ids in input order.
command duplicateLayers = 202 { layers: LayerId[] = 1; } -> LayerList;
/// Move layers (keeping their relative order) so the first lands at `toIndex` in the stack.
command reorderLayers = 203 { comp: ItemId = 1; layers: LayerId[] = 2; toIndex: u32 = 3; }
/// Parent layers (absent parent = unparent). keepWorldTransform = AE's default (no jump).
command setParent = 204 {
  layers: LayerId[] = 1;
  parent?: LayerId = 2;
  keepWorldTransform: bool = 3;
  /// B3z — Parent & Link JUMP (AE's Shift-pickwhip): relink WITHOUT compensation, then move each child onto the parent's anchor: its Position becomes 0,0 in the parent's layer space at `time` (an animated Position is re-based rigidly by the same offset, keeping its motion). Ignored when un-parenting. `keepWorldTransform` is not read when set.
  jump?: bool = 4;
  /// The composition time the jump measures an animated Position at (AE: the current time). Absent = 0.
  time?: Time = 5;
}
command renameLayer = 205 { layer: LayerId = 1; name: string = 2; }
/// Change switches on several layers at once. Undo restores each layer's previous value of each patched switch.
command setLayerSwitches = 206 { layers: LayerId[] = 1; patch: LayerSwitchesPatch = 2; }
command setBlendMode = 207 { layers: LayerId[] = 1; mode: BlendMode = 2; }
command setTrackMatte = 208 { layer: LayerId = 1; matte: TrackMatte = 2; }
/// Replace a footage/precomp layer's source (Alt-drag replace). keepSize=false resizes to the new source.
command replaceLayerSource = 209 { layer: LayerId = 1; source: ItemId = 2; keepSize: bool = 3; }
/// Group layers under a new group layer (Premation groups; AE has none).
command groupLayers = 210 { layers: LayerId[] = 1; name: string = 2; } -> LayerRef;
command ungroupLayer = 211 { group: LayerId = 1; } -> LayerList;

enum LayerConversion {
  shapesFromText = 0;
  masksFromText = 1;
  shapesFromVector = 2;
  editableText = 3;
  /// Precomp → layers (Uncompose).
  uncompose = 4;
  /// Bake every expression and parent into keyframes on a copy.
  bakeTransform = 5;
}

/// Engine-evaluated conversions (the result depends on fonts, outlines or evaluation, so it cannot be a client macro).
command convertLayer = 212 { layer: LayerId = 1; conversion: LayerConversion = 2; } -> LayerList;
/// Paste a document fragment (from copyLayers) into a composition at `time`. References BETWEEN pasted layers follow the copies (AE: parenting, track mattes): a matte source, a layer-valued effect parameter, a cloner's path/falloff layer, an audio driver's source layer, a clone-stamp stroke's source layer and a plugin layer's layer-valued prop that name a layer of the fragment name its copy; references to layers outside the fragment are kept as they are (ENGINE_API.md §4.4). Returns the new ids in fragment order.
command pasteLayers = 213 {
  comp: ItemId = 1;
  fragment: DocumentFragment = 2;
  time?: Time = 3;
  /// Stack index (0 = top) among the composition's layers, as createLayer's `index`.
  index?: u32 = 4;
  /// Paste INTO this layer of `comp` (Premation groups nest): the fragment's top-level layers become its children. Absent = the composition itself.
  parent?: LayerId = 5;
} -> LayerList;
/// Split a camera/text/shape into per-part layers (Create Shapes → Separate, Break Apart text).
command separateLayer = 214 { layer: LayerId = 1; } -> LayerList;
/// Auto-trace a layer's alpha/luma into masks over a range (Layer ▸ Auto-trace).
command autoTrace = 215 { layer: LayerId = 1; range: TimeRange = 2; channel: string = 3; threshold: f64 = 4; tolerance: f64 = 5; } -> GroupList;

/// The layer's comment (Comments column).
command setLayerComment = 216 { layer: LayerId = 1; comment: string = 2; }

/// A self-contained piece of document (layers + the items they reference) as produced by copyLayers. Opaque to the UI.
struct DocumentFragment {
  /// Fragment format version.
  version: u32 = 1;
  /// Encoded payload (engine-defined; JSON in the TS engine).
  data: bytes = 2;
}

struct LayerRef { layer: LayerId = 1; }
struct LayerList { layers: LayerId[] = 1; }
struct GroupList { groups: PropPath[] = 1; }

family "LayerTime";

enum Edge { in = 0; out = 1; }

enum RetimeMode { normal = 0; speed = 1; frames = 2; }

/// The primitive for every bar edit: set in/out/start/stretch of several layers. Trim and move are this command.
command setLayerTiming = 300 [coalesce] { items: LayerTimingPatch[] = 1; }
/// Move layers in time by `delta`. ripple=true shifts every later layer in the composition by the same amount.
command moveLayersInTime = 301 [coalesce] { layers: LayerId[] = 1; delta: Time = 2; ripple: bool = 3; }
/// Trim one edge of each layer to `time`. ripple=true closes/opens the gap for later layers.
command trimLayers = 302 [coalesce] { layers: LayerId[] = 1; edge: Edge = 2; time: Time = 3; ripple: bool = 4; }
/// Slip: move the source under fixed in/out points.
command slipLayers = 303 [coalesce] { layers: LayerId[] = 1; delta: Time = 2; }
/// Slide: move in/out together keeping the source frame at the cut, trimming the neighbours.
command slideLayer = 304 [coalesce] { layer: LayerId = 1; delta: Time = 2; }
/// Roll the cut between two adjacent layers.
command rollEdit = 305 [coalesce] { left: LayerId = 1; right: LayerId = 2; delta: Time = 3; }
/// Split layers at `time` (Ctrl+Shift+D). The original keeps the left part and its id; returns the right parts' ids.
command splitLayers = 306 { layers: LayerId[] = 1; time: Time = 2; } -> LayerList;
/// Delete layers and close the gap they leave.
command rippleDeleteLayers = 307 { layers: LayerId[] = 1; }

enum WorkAreaEdit { lift = 0; extract = 1; }

/// Lift (leave a gap) or extract (close it) the work area from layers (all layers when empty).
command editWorkArea = 308 { comp: ItemId = 1; edit: WorkAreaEdit = 2; layers: LayerId[] = 3; } -> LayerList;
/// Insert a gap at `time` of `duration`, pushing later layers.
command insertGap = 309 { comp: ItemId = 1; time: Time = 2; duration: Time = 3; }
/// Reverse layer time (stretch → -stretch, keyframes mirrored).
command timeReverseLayers = 310 { layers: LayerId[] = 1; }
/// Enable time remapping; enabling creates the two boundary keyframes AE creates; disabling removes the property.
command setTimeRemap = 311 { layer: LayerId = 1; enabled: bool = 2; }
/// Freeze the layer on `time` (Freeze Frame) or on its last frame.
command freezeFrame = 312 { layer: LayerId = 1; time?: Time = 2; lastFrame: bool = 3; }
/// Retime mode (Normal / Speed % / Frames) with its parameter.
command setRetime = 313 { layer: LayerId = 1; mode: RetimeMode = 2; speed?: f64 = 3; }
/// Lay layers end to end in stack order, with overlap (Keyframe Assistant ▸ Sequence Layers).
command sequenceLayers = 314 { layers: LayerId[] = 1; overlap: Time = 2; crossfade: bool = 3; }

/// Where Time Stretch holds the layer (AE's Hold in Place).
enum StretchHold {
  /// The layer's in point stays put.
  inPoint = 0;
  /// The frame at `time` shows the same source frame before and after.
  currentFrame = 1;
  /// The layer's out point stays put.
  outPoint = 2;
}

/// B3z — AE's Time Stretch dialog. `stretch` is the layer's NEW absolute stretch (1 = 100 %, rounded to whole percent, |stretch| within 0.01…10). Footage, audio and precomps change their playback rate and the bar scales about the Hold in Place frame with the source frame there unchanged (stretch must be positive: footage reverses with timeReverseLayers). Any other layer has no source to resample: its bar(s), every keyframe and its layer markers are scaled about the hold frame by the ratio to its current stretch, a negative value reverses them, and the value is recorded as the layer's stretch. Locked bars are left alone. `time` (comp) is required for currentFrame. Inverse: the previous bars, keys, markers and stretch.
command timeStretchLayers = 330 { layers: LayerId[] = 1; stretch: f64 = 2; hold: StretchHold = 3; time?: Time = 4; }
/// B3z — remove Freeze Frame from layers (the layer plays its source again). A layer that is not frozen is left as it is. Inverse: the previous freeze and freeze time.
command unfreezeLayers = 331 { layers: LayerId[] = 1; }
/// B3z — delete a composition TIME RANGE and close the gap (transcript editing, a range extract): every unlocked layer of `layers` (empty = every layer of the comp) that crosses an edge of `range` is split there, the parts inside are deleted, then EVERY unlocked layer starting at or after the range end moves left by the range's length. Locked layers are never cut, deleted or moved. Returns the layers the splits created. Inverse: the layers, bars and every shifted timing restored exactly.
command rippleDeleteRange = 332 { comp: ItemId = 1; range: TimeRange = 2; layers: LayerId[] = 3; } -> LayerList;

/// One layer's keyframe shift (shiftLayerKeyframes).
struct LayerKeyShift {
  layer: LayerId = 1;
  /// In LAYER time (the axis keyframes are stored on; = comp time for an unstretched layer). May be fractional frames and may move keys before 0.
  delta: Time = 2;
}

/// B3z — move EVERY keyframe a layer owns by a layer-time delta (Stagger / Sequence animation): every animated property, the data tracks (Source Text, gradient stops, mask shapes) — not the time-remap / speed tracks, which live on the composition axis. Unlike moveKeyframes it neither frame-quantises through the bar nor needs keyframe ids for properties outside the catalog. Inverse: the previous keys (same ids).
command shiftLayerKeyframes = 333 { items: LayerKeyShift[] = 1; }

enum TransitionKind { crossDissolve = 0; dipToBlack = 1; dipToWhite = 2; wipe = 3; }
/// Where a transition sits relative to its cut.
enum TransitionAlignment { centred = 0; startAtCut = 1; endAtCut = 2; }

/// A cut transition (the timeline's bracket): a record on the composition, MATERIALISED into the two layers — the overlapping kinds (crossDissolve, wipe) extend the left bar's tail and the right bar's head into their source handles; crossDissolve / dipToBlack ramp Opacity, dipToWhite ramps a white Fill effect, wipe ramps a Linear Wipe on the incoming layer.
struct Transition {
  id: string = 1;
  comp: ItemId = 2;
  /// The layer whose bar ends at the cut.
  left: LayerId = 3;
  /// The layer whose bar starts at the cut.
  right: LayerId = 4;
  kind: TransitionKind = 5;
  /// Whole frames of the composition.
  duration: Time = 6;
  alignment: TransitionAlignment = 7;
}

struct TransitionRef { transition: string = 1; }

/// B3z — add a transition on the cut between two layers of one composition (replacing any transition already on that cut). Refused (`outOfRange`, with the frames the handles lack) when a source cannot pay for the overlap, `invalidArgument` when the layers do not meet at a cut, `locked` for a locked layer. `duration` rounds to whole frames (≥ 1). Returns the new transition's id. Inverse: the cut, the bars, the keys and effects exactly as they were, and the record gone.
command addTransition = 334 { left: LayerId = 1; right: LayerId = 2; kind: TransitionKind = 3; duration: Time = 4; alignment: TransitionAlignment = 5; } -> TransitionRef;
/// B3z — change a transition's kind, length or alignment (the bracket drag, the alignment menu): the cut is restored to what it was before the transition, then the new one materialised. Coalescable: a drag sends the absolute length per move. Refusals as addTransition (the record is unchanged). Inverse: the previous record and everything it materialised.
command setTransition = 335 [coalesce] { transition: string = 1; kind?: TransitionKind = 2; duration?: Time = 3; alignment?: TransitionAlignment = 4; }
/// B3z — remove transitions: each cut is put back exactly as it was before the transition was applied (bars, the ramped keys, the effect stack). Hand edits made to those tracks afterwards are discarded with it (transitions.ts). Inverse: the records and their materialisation.
command removeTransitions = 336 { transitions: string[] = 1; }
