// Long-running engine jobs: analysis, tracking, rendering. A job never edits
// the document while it runs; when it finishes, its result is applied as ONE
// history entry labelled with the job (origin = engine), unless apply=false.
// Command ids: 850–899.
//
// 2026-09-27 (engine-jobs): the C++ engine runs jobs itself (src/jobs): the
// inputs are read from the document when the job starts, the work runs on a
// worker thread (a job that loads a model runs in a child engine process, so
// a crash there fails the job, not the engine), progress arrives as
// `jobProgress`, and the result is written through the same commands the UI
// would send — one history entry, undoable. `JobInfo.result` carries each
// kind's summary as JSON (documented per kind in docs/ENGINE_API.md §4.9).

family "Jobs";

enum TrackKind { position = 0; positionRotation = 1; positionRotationScale = 2; perspectiveCorner = 3; mask = 4; planar = 5; }
enum TrackDirection { forward = 0; backward = 1; both = 2; }

struct TrackPointSpec {
  /// Feature region centre + size, search region size, in layer pixels.
  feature: Rect = 1;
  search: Rect = 2;
  attach: Vec2 = 3;
}

struct TrackMotionJob {
  layer: LayerId = 1;
  /// `mask` (maskTrack.ts trackLayerMask): the points are the vertices of the layer's masks as they stand at the origin (every mask, or the one `applyTo` names as `masks/<id>`; `points` gives only the window sizes), and the result is written as path keys on those masks. `planar`: see `planarGrid`.
  kind: TrackKind = 2;
  points: TrackPointSpec[] = 3;
  range: TimeRange = 4;
  direction: TrackDirection = 5;
  /// Where to apply: a layer's transform, an effect point, a mask. Absent = keep as tracker data only.
  applyTo?: PropRef = 6;
  /// The time the points' positions are given at (layer pixels on that frame). Default: `range.start` for `forward`, the range's last frame for `backward`, the playhead clamped into the range for `both` (tracked outward from there, autoTrack.ts).
  origin?: Time = 706;
  /// NCC below this is a lost frame: the point coasts on its last confident velocity (tracker.ts `minConfidence`, default 0.55).
  minConfidence?: f64 = 707;
  /// Consecutive coasted frames before a point is given up (tracker.ts `maxCoastFrames`, default 8).
  maxCoastFrames?: u32 = 708;
  /// Long edge the footage is decoded at for the analysis (the TS analysis tier; default 960, 0 = full size). Points, sizes and the result stay in layer pixels.
  analysisMaxEdge?: u32 = 709;
  /// Stabilize Motion (trackerStore mode `stabilize`, applyTrack.ts planStabilize): point 0's inverse motion written as position keys on the TRACKED layer; `applyTo` is not read. Kind `position` only.
  stabilize: bool = 710;
  /// Kind `planar` (the corner mode's "Dense grid", planarFit.ts densifyQuad): the quad TL, TR, BR, BL (+ any points after it, kept) gains a `planarGrid`×`planarGrid` lattice of features inside it (default 5, 1…16) and the corner pin is the RANSAC plane over all of them.
  planarGrid?: u32 = 1710;
}

/// `method`: `position` (translate only), `positionRotation`, `positionRotationScale` (default). `smoothness` 0…100 (%).
struct StabilizeJob {
  layer: LayerId = 1;
  range: TimeRange = 2;
  smoothness: f64 = 3;
  method: string = 4;
  /// Long edge the footage is decoded at (the TS analysis tier; default 960, 0 = full size). The flow itself runs at most 480 px wide, as smoothStabilize.ts.
  analysisMaxEdge?: u32 = 704;
  /// smoothStabilize.ts `variant`: `similarity` (default — position / rotation / scale keys per `method`), `subspace` (a 4×4 grid of local similarities → Mesh Warp keys on the layer, subspaceWarp.ts), `rolling-shutter` (the subspace grid with the rows' readout shear repaired).
  variant?: string = 1704;
}
/// `channel`: `alpha`, `luminance`, `red`, `green`, `blue`; `threshold` 0…1. Only the frame at `range.start` is traced unless `everyFrame` (then one mask path key per frame of the range).
struct AutoTraceJob {
  layer: LayerId = 1;
  range: TimeRange = 2;
  channel: string = 3;
  threshold: f64 = 4;
  /// Path simplification tolerance in pixels (autoTrace.ts `tolerance`, default 1.5).
  tolerance?: f64 = 704;
  /// Blur radius (px) applied to the channel before thresholding (default 0).
  blur?: f64 = 705;
  /// Smallest traced area, pixels (default 16).
  minArea?: f64 = 706;
  everyFrame: bool = 707;
  /// Invert the matte before tracing.
  invert: bool = 708;
  /// Trace what the layer DRAWS (autoTrace.ts renderLayerAlone): the layer rendered alone (solo, transparent comp, its effects and masks included) by a child engine, comp-space contours pulled back through the layer's inverse transform at each frame. False: the layer's own footage frames (layer pixels). Any layer kind when true; footage only when false.
  rendered: bool = 1708;
}
/// Scene Edit Detection (sceneEditDetect.ts): cuts and dissolves in a video layer's visible span, from 64-bin luma-histogram distances with an adaptive threshold. `createMarkers`: composition markers "Cut N" / "Dissolve N"; `splitLayers`: the layer split at every cut (markers win when both are set). `threshold` is the L1 floor (0…2, default 0.3), `sensitivity` the multiple of the local median (default 5), `minShotSeconds` absent = 6 frames; `dissolves` default true.
struct SceneDetectJob {
  layer: LayerId = 1;
  createMarkers: bool = 2;
  splitLayers: bool = 3;
  threshold?: f64 = 703;
  minShotSeconds?: f64 = 704;
  sensitivity?: f64 = 705;
  dissolves?: bool = 706;
}
/// `prompts` are foreground clicks in layer pixels at `range.start`; `backgroundPrompts` background clicks. The matte is applied as masks traced from the segmentation.
struct ObjectMatteJob {
  layer: LayerId = 1;
  range: TimeRange = 2;
  prompts: Vec2[] = 3;
  backgroundPrompts: Vec2[] = 703;
  /// The SAM encoder / decoder ONNX files (the page's bundled `models/object-matte/*` or the user's install). Empty = the engine's default search (PREMATION_SAM_DIR).
  encoderModel: string = 704;
  decoderModel: string = 705;
  /// A drawn box prompt in layer pixels at `range.start` (objectMask.ts marquee). It wins over `prompts` / `backgroundPrompts` when both arrive: its centre is the foreground point, and nothing outside it (plus an 8% + 4 px margin) is kept.
  box?: Rect = 706;
  /// The mask the result writes (P4, the Roto Brush tool): its name (absent = "Object mask"), mode (absent = none: geometry for Track mask, not a cut) and feather (absent = 2 px).
  maskName?: string = 707;
  maskMode?: MaskMode = 708;
  feather?: f64 = 709;
  /// Masks of `layer` (their ids, `masks/<id>`) removed in the same history entry as the new one is added — a re-segment replacing the tool's previous outline.
  replaceMasks: string[] = 710;
}
/// Transcription (captions/transcribe.ts transcribeCompositionDetailed): `comp`'s sound over `range` (absent = the whole composition) mixed down by a child engine (the export's offline mix: levels, trims, mutes), 16 kHz mono, sent to the user's speech provider; the summary is `{"cues":[{start,end,text}],"words":[…],"language":S}` in composition seconds, cues de-overlapped. Nothing is written (`createCaptions` must be false — the caption commands build layers from the cues). `layer` is not read yet (a single layer's sound is not isolated; send '').
/// `provider` names the key (`openai`; the others have no timed speech API and are refused). `credential` is filled by Electron MAIN from its keystore as the request passes through it — a page never has the key, and a value the page sends is replaced. The engine keeps it only for the one request to the provider: it is never persisted, logged, or returned (the engine's own log and getJobs drop it).
struct TranscribeJob {
  layer: LayerId = 1;
  language: string = 2;
  createCaptions: bool = 3;
  comp?: ItemId = 704;
  range?: TimeRange = 705;
  provider: string = 706;
  credential?: string = 707;
}
/// One audio analysis over a layer's sound (an audio layer, or a video layer's own track).
struct AudioAnalysisJob {
  layer: LayerId = 1;
  /// Beat grid (beatGrid.ts analyseLayerBeats): bpm, confidence, beats and onsets in composition seconds in the summary.
  beats: bool = 2;
  /// Amplitude envelope → keyframes (audioKeyframes.ts): on the layer's `audioAmplitude` slider control.
  amplitudeKeyframes: bool = 3;
  /// Silence detection (silenceRemoval.ts detectSilences); with `removeSilence` the silent stretches are cut out of the layer and the layers playing the same file in its composition, gaps closed.
  silence: bool = 703;
  removeSilence: bool = 704;
  silenceThresholdDb?: f64 = 705;
  silenceMinMs?: f64 = 706;
  silencePaddingMs?: f64 = 707;
  /// `both` (default), `left`, `right` — the channel the amplitude envelope follows.
  amplitudeChannel?: string = 708;
  /// Envelope smoothing window in frames (default 1 = none).
  amplitudeSmoothing?: u32 = 709;
  /// Sample every Nth frame (default 1), keep a frame only when it moves ≥ minDelta (0–100, default 2), scale by gain (default 1) — AudioKeyframeOptions.
  amplitudeFrameStep?: u32 = 710;
  amplitudeMinDelta?: f64 = 711;
  amplitudeGain?: f64 = 712;
  /// With `beats`: composition markers "Beat N" on every `beatEvery`-th beat (default 1; at most 512) — Markers on Beats. Without it the grid is the summary only (Animate on Beats reads it).
  beatMarkers: bool = 713;
  beatEvery?: u32 = 714;
  /// B4 round 8 — After Effects' Convert Audio to Keyframes: a new "<layer> Amplitude" NULL in the layer's composition carrying three Slider Controls ("Both Channels", "Left", "Right"), each keyed from its channel's envelope (the amplitude options above apply; keys at composition time through the layer's bar). Any audio or video layer with sound; independent of `amplitudeKeyframes`. The summary's `amplitudeNull` counts the keys per channel.
  amplitudeNull?: bool = 715;
}
/// Ducking (ducking.ts planDucking): lower `music`'s level under the voice (`voices[0]`; the page's dialog ducks under one layer) over the composition's work area, as Audio Levels keyframes, and remember the parameters (`audio/ducking`). `params` is the DuckingParams JSON (duckDb, thresholdDb, attackMs, releaseMs, holdMs); absent keys take the defaults.
struct AudioDuckJob { music: LayerId = 1; voices: LayerId[] = 2; params: string = 3; }
/// Noise gate (audioGate.ts computeGateEnvelope + planGate): close the layer's level while it is quiet, over its audible span inside the work area, as Audio Levels keyframes, and remember the parameters (`audio/gate`). `params` is the GateParams JSON (thresholdDb, attackMs, holdMs, releaseMs, rangeDb).
struct AudioGateJob { layer: LayerId = 1; params: string = 2; }
/// A low-resolution editing proxy for a footage item (assets/proxy.ts): transcoded by ffmpeg into `outputFolder` (default: next to the project, `Proxies/`), then attached with setProxy. `maxEdge` default 960.
struct ProxyJob { item: ItemId = 1; outputFolder: string = 2; maxEdge?: u32 = 3; }
struct RenderJob { items: RenderItemId[] = 1; }
/// Pre-render (Pre-render / proxy creation) of compositions to files.
struct PrerenderJob { comps: ItemId[] = 1; outputFolder: string = 2; format: string = 3; }

/// What a finished track is applied as (trackMotionActions.ts onApply / onApplyMesh / onCreateNullAndApply / onCreateNullsForPlanes / onSolveCamera).
enum TrackApplyMode { follow = 0; transform = 1; corner = 2; stabilize = 3; meshWarp = 4; createNull = 5; nullsForPlanes = 6; cameraSolve = 7; }
/// One tracked sample: composition time, layer (source display) pixels, NCC confidence, coasted through a loss.
struct TrackSampleRow { time: Time = 1; x: f64 = 2; y: f64 = 3; confidence: f64 = 4; coasted: bool = 5; }
struct TrackSeries { samples: TrackSampleRow[] = 1; }
/// Apply a track the UI already holds (a `trackMotion` job's `tracks`, or the page tracker's) — the plans of applyTrack.ts / trackApplyEdits.ts in the engine, ONE history entry:
/// `follow` planTrackToLayer (a camera target: planTrackToCamera); `transform` planTransformTrack with rotation and scale (a camera: planCameraSolveTrack); `corner` planCornerPinTrack; `stabilize` planStabilize on `layer`; `meshWarp` planMeshWarpTrack; `createNull` Create Null & Apply (a "Tracked Null" beside the footage, keyed per `nullMode`: follow | transform | corner); `nullsForPlanes` one null per four tracks (corner pins); `cameraSolve` the 3D Camera Tracker (sfmCamera.ts, planar-hybrid SfM + bundle adjustment) keyed onto the composition's solve camera, made on the first run. `target` is read by follow / transform / corner / meshWarp.
struct TrackApplyJob {
  layer: LayerId = 1;
  mode: TrackApplyMode = 2;
  target?: LayerId = 3;
  tracks: TrackSeries[] = 4;
  sourceWidth: f64 = 5;
  sourceHeight: f64 = 6;
  nullMode?: TrackApplyMode = 7;
}
/// Roto Brush (rotoBrush.ts runRotoBrush): a GrabCut-class matte from the `seed` click (layer pixels at `range.start`, colour `tolerance` default 36), propagated frame to frame by block flow with a colour re-seed, as ONE "Roto Brush" mask with a path key per frame of the range (feather `feather` px, default 2).
struct RotoBrushJob { layer: LayerId = 1; range: TimeRange = 2; seed: Vec2 = 3; tolerance?: f64 = 4; feather?: f64 = 5; }
/// Content-Aware Fill (contentAwareFillVideo.ts runContentAwareFill): the layer's masks at each frame of the range are the hole, filled by PatchMatch then carried by flow both ways; the filled frames are PNGs written to `outputFolder` (default: next to the project, `Content-Aware Fill/`) and attached with setContentAwareFill (the renderer shows the nearest filled frame over the footage).
struct ContentAwareFillJob { layer: LayerId = 1; range: TimeRange = 2; outputFolder: string = 3; }
/// Auto-reframe (autoReframe.ts autoReframeComposition): `comp` rendered small (160 px wide, 12 frames/s) by a child engine, saliency + shot cuts per frame (saliency.ts, sceneEditDetect.ts), a dead-zone / lag camera path (reframePath.ts); a NEW composition `width`×`height` holding `comp` as a precomp layer scaled to cover, with the pan keyed on its separated position. The source is untouched.
struct AutoReframeJob { comp: ItemId = 1; width: u32 = 2; height: u32 = 3; name?: string = 4; deadZone?: f64 = 5; lagSeconds?: f64 = 6; }
/// Bake Physics to Keyframes (bakeDynamics.ts bakePhysicsToKeyframes): the composition's rigid bodies stepped by the renderer's own solver (every body, so collisions match the viewport; the world is the engine's: gravity 0 / 1800, the comp rectangle as walls, 4 passes), sampled at each frame of `range` (every `everyNFrames`th, the last frame always) and written onto the `layers` that carry an enabled DYNAMIC body — position, and rotation for a body that spins — as linear keys with the last one held, Douglas-Peucker thinned by `simplifyTolerance` (value units; 0 = every sample). Their physics is switched off in the same entry. Refused (invalidArgument) when none of `layers` has an enabled dynamic body.
struct PhysicsBakeJob { layers: LayerId[] = 1; range: TimeRange = 2; everyNFrames?: u32 = 3; simplifyTolerance?: f64 = 4; }
/// Bake Particles to Layers (bakeDynamics.ts bakeParticlesToLayers): the emitter's particles (the renderer's sim, its `particle.<key>` tracks sampled per frame) at each frame of `range`, one keyed ellipse (a square emitter: rectangle) per particle — x / y / scale / opacity, invisible outside its life — under a new "<emitter> Baked" null parented to the emitter; the emitter is hidden. At most `maxParticles` (default 200) layers, the earliest born; the summary reports `seen` and `capped`.
struct ParticleBakeJob { layer: LayerId = 1; range: TimeRange = 2; everyNFrames?: u32 = 3; simplifyTolerance?: f64 = 4; maxParticles?: u32 = 5; }
/// The audio driver's envelope (audioDriver.ts computeDriverEnvelope's analysis half): `source`'s sound laid out on composition time over `range` (a layer, through its bar), or, `source` absent, the composition's own mix (a child `--export` audio-only, as the transcribe job mixes it) of `comp`; the spectral detector over [`bandLo`, `bandHi`] Hz, gated, attack / release smoothed, normalised unless `normalize` is false: 0..1 per composition frame. Analysis only (nothing is written): the summary is `{raw, fps, start, end}`.
struct AudioEnvelopeJob { comp: ItemId = 1; source?: LayerId = 2; range: TimeRange = 3; bandLo: f64 = 4; bandHi: f64 = 5; attackMs?: f64 = 6; releaseMs?: f64 = 7; gate?: f64 = 8; normalize?: bool = 9; }

union JobSpec {
  trackMotion: TrackMotionJob = 1;
  stabilize: StabilizeJob = 2;
  autoTrace: AutoTraceJob = 3;
  sceneDetect: SceneDetectJob = 4;
  objectMatte: ObjectMatteJob = 5;
  transcribe: TranscribeJob = 6;
  audioAnalysis: AudioAnalysisJob = 7;
  render: RenderJob = 8;
  prerender: PrerenderJob = 9;
  proxy: ProxyJob = 709;
  audioDuck: AudioDuckJob = 710;
  audioGate: AudioGateJob = 711;
  trackApply: TrackApplyJob = 1711;
  rotoBrush: RotoBrushJob = 1712;
  contentAwareFill: ContentAwareFillJob = 1713;
  autoReframe: AutoReframeJob = 1714;
  physicsBake: PhysicsBakeJob = 1715;
  particleBake: ParticleBakeJob = 1716;
  audioEnvelope: AudioEnvelopeJob = 1717;
}

command startJob = 850 [control] { job: JobSpec = 1; apply: bool = 2; } -> JobRef;
command cancelJob = 851 [control] { job: JobId = 1; }
/// Apply a finished job's result (when started with apply=false). One history entry.
command applyJobResult = 852 { job: JobId = 1; } -> ItemList;

struct JobRef { job: JobId = 1; }

/// A content-aware fill frame: `time` in composition time, `src` the filled picture (a file path or URL the renderer reads as a still).
struct ContentAwareFillFrame { time: Time = 1; src: string = 2; }
/// The layer's content-aware fill (the content-aware fill job's result; the page stored the same record as `fx.contentAwareFill`): the frame nearest the layer's time stands in for its footage. Empty `frames` clears it. Inverse: the previous record.
command setContentAwareFill = 1852 { layer: LayerId = 1; frames: ContentAwareFillFrame[] = 2; }

family "Plugins";

/// Enable/disable an installed plugin for this session (install/uninstall stays in the editor's plugin manager).
command setPluginEnabled = 870 [control] { plugin: string = 1; enabled: bool = 2; }
/// Store plugin data in the DOCUMENT (AE sequence data / arbitrary-data params). Undoable, saved with the project.
command setPluginData = 871 { layer: LayerId = 1; group: PropPath = 2; key: string = 3; data: bytes = 4; }
