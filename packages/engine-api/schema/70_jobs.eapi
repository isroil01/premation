// Long-running engine jobs: analysis, tracking, rendering. A job never edits
// the document while it runs; when it finishes, its result is applied as ONE
// history entry labelled with the job (origin = engine), unless apply=false.
// Command ids: 850–899.
//
// 2026-09-27 (engine-jobs): the C++ engine runs jobs itself (src/jobs): the
// inputs are read from the document when the job starts, the work runs on a
// worker thread (a job that loads a model runs in a child engine process, so
// a crash there fails the job, not the engine), progress arrives as
// `jobProgress`, and the result is written through the same commands the UI
// would send — one history entry, undoable. `JobInfo.result` carries each
// kind's summary as JSON (documented per kind in docs/ENGINE_API.md §4.9).

family "Jobs";

enum TrackKind { position = 0; positionRotation = 1; positionRotationScale = 2; perspectiveCorner = 3; mask = 4; planar = 5; }
enum TrackDirection { forward = 0; backward = 1; both = 2; }

struct TrackPointSpec {
  /// Feature region centre + size, search region size, in layer pixels.
  feature: Rect = 1;
  search: Rect = 2;
  attach: Vec2 = 3;
}

struct TrackMotionJob {
  layer: LayerId = 1;
  kind: TrackKind = 2;
  points: TrackPointSpec[] = 3;
  range: TimeRange = 4;
  direction: TrackDirection = 5;
  /// Where to apply: a layer's transform, an effect point, a mask. Absent = keep as tracker data only.
  applyTo?: PropRef = 6;
}

/// `method`: `position` (translate only), `positionRotation`, `positionRotationScale` (default). `smoothness` 0…100 (%).
struct StabilizeJob { layer: LayerId = 1; range: TimeRange = 2; smoothness: f64 = 3; method: string = 4; }
/// `channel`: `alpha`, `luminance`, `red`, `green`, `blue`; `threshold` 0…1. Only the frame at `range.start` is traced unless `everyFrame` (then one mask path key per frame of the range).
struct AutoTraceJob {
  layer: LayerId = 1;
  range: TimeRange = 2;
  channel: string = 3;
  threshold: f64 = 4;
  /// Path simplification tolerance in pixels (autoTrace.ts `tolerance`, default 1).
  tolerance?: f64 = 704;
  /// Blur radius (px) applied to the channel before thresholding (default 0).
  blur?: f64 = 705;
  /// Smallest traced area, pixels (default 16).
  minArea?: f64 = 706;
  everyFrame: bool = 707;
  /// Invert the matte before tracing.
  invert: bool = 708;
}
/// Cuts in a footage layer's picture. `threshold` 0…1 (the frame-difference score above which a frame starts a new shot; default 0.35); `minShotSeconds` default 0.5.
struct SceneDetectJob {
  layer: LayerId = 1;
  createMarkers: bool = 2;
  splitLayers: bool = 3;
  threshold?: f64 = 703;
  minShotSeconds?: f64 = 704;
}
/// `prompts` are foreground clicks in layer pixels at `range.start`; `backgroundPrompts` background clicks. The matte is applied as masks traced from the segmentation.
struct ObjectMatteJob {
  layer: LayerId = 1;
  range: TimeRange = 2;
  prompts: Vec2[] = 3;
  backgroundPrompts: Vec2[] = 703;
  /// The SAM encoder / decoder ONNX files (the page's bundled `models/object-matte/*` or the user's install). Empty = the engine's default search (PREMATION_SAM_DIR).
  encoderModel: string = 704;
  decoderModel: string = 705;
}
struct TranscribeJob { layer: LayerId = 1; language: string = 2; createCaptions: bool = 3; }
/// One audio analysis over a layer's sound (an audio layer, or a video layer's own track).
struct AudioAnalysisJob {
  layer: LayerId = 1;
  /// Beat grid → composition markers on the beats (beatGrid.ts).
  beats: bool = 2;
  /// Amplitude envelope → keyframes (audioKeyframes.ts): on the layer's `audioAmplitude` slider control.
  amplitudeKeyframes: bool = 3;
  /// Silence detection (silenceRemoval.ts detectSilences); with `removeSilence` the silent stretches are cut out of the layer and the layers playing the same file in its composition, gaps closed.
  silence: bool = 703;
  removeSilence: bool = 704;
  silenceThresholdDb?: f64 = 705;
  silenceMinMs?: f64 = 706;
  silencePaddingMs?: f64 = 707;
  /// `both` (default), `left`, `right` — the channel the amplitude envelope follows.
  amplitudeChannel?: string = 708;
  /// Envelope smoothing window in frames (default 1 = none).
  amplitudeSmoothing?: u32 = 709;
}
/// Ducking (ducking.ts): lower `music`'s level under the `voices`, as Audio Levels keyframes. `params` is the DuckingParams JSON (amountDb, thresholdDb, attackMs, releaseMs, holdMs); absent keys take the defaults.
struct AudioDuckJob { music: LayerId = 1; voices: LayerId[] = 2; params: string = 3; }
/// Noise gate (audioGate.ts): close the layer's level while it is quiet, as Audio Levels keyframes. `params` is the GateParams JSON.
struct AudioGateJob { layer: LayerId = 1; params: string = 2; }
/// A low-resolution editing proxy for a footage item (assets/proxy.ts): transcoded by ffmpeg into `outputFolder` (default: next to the project, `Proxies/`), then attached with setProxy. `maxEdge` default 960.
struct ProxyJob { item: ItemId = 1; outputFolder: string = 2; maxEdge?: u32 = 3; }
struct RenderJob { items: RenderItemId[] = 1; }
/// Pre-render (Pre-render / proxy creation) of compositions to files.
struct PrerenderJob { comps: ItemId[] = 1; outputFolder: string = 2; format: string = 3; }

union JobSpec {
  trackMotion: TrackMotionJob = 1;
  stabilize: StabilizeJob = 2;
  autoTrace: AutoTraceJob = 3;
  sceneDetect: SceneDetectJob = 4;
  objectMatte: ObjectMatteJob = 5;
  transcribe: TranscribeJob = 6;
  audioAnalysis: AudioAnalysisJob = 7;
  render: RenderJob = 8;
  prerender: PrerenderJob = 9;
  proxy: ProxyJob = 709;
  audioDuck: AudioDuckJob = 710;
  audioGate: AudioGateJob = 711;
}

command startJob = 850 [control] { job: JobSpec = 1; apply: bool = 2; } -> JobRef;
command cancelJob = 851 [control] { job: JobId = 1; }
/// Apply a finished job's result (when started with apply=false). One history entry.
command applyJobResult = 852 { job: JobId = 1; } -> ItemList;

struct JobRef { job: JobId = 1; }

family "Plugins";

/// Enable/disable an installed plugin for this session (install/uninstall stays in the editor's plugin manager).
command setPluginEnabled = 870 [control] { plugin: string = 1; enabled: bool = 2; }
/// Store plugin data in the DOCUMENT (AE sequence data / arbitrary-data params). Undoable, saved with the project.
command setPluginData = 871 { layer: LayerId = 1; group: PropPath = 2; key: string = 3; data: bytes = 4; }
