// Properties, keyframes, expressions and property groups (effects, masks,
// text animators, selectors, shape contents, layer styles, paint strokes,
// puppet pins). Command ids: 400–699. Addressing: ENGINE_API.md §3.4.

family "Properties";

/// One property write inside setProperties.
struct PropertyWrite {
  prop: PropRef = 1;
  value: Value = 2;
  time?: Time = 3;
}

/// Set a property.
/// Not animated: sets the static value (time is ignored).
/// Animated: `time` is required; creates the keyframe at `time` or replaces its value (AE setValueAtTime). No time → error `animated`.
/// Undo restores the previous static value, or removes the created keyframe / restores the replaced value.
command setProperty = 400 [coalesce] { prop: PropRef = 1; value: Value = 2; time?: Time = 3; } -> PropertyWriteResult;
/// Many writes, one command (multi-layer drags). Same rules per write; all-or-nothing.
command setProperties = 401 [coalesce] { writes: PropertyWrite[] = 1; }
/// Reset to the property's default (a keyframe at `time` if animated).
command resetProperty = 402 { prop: PropRef = 1; time?: Time = 2; }
/// The stopwatch. On: one keyframe at `time` holding the current value. Off: removes every keyframe; the static value becomes the value at `time`.
command setAnimated = 403 { prop: PropRef = 1; animated: bool = 2; time: Time = 3; } -> PropertyWriteResult;
/// Separate Dimensions (position → X/Y/Z Position). Keyframes are split/merged exactly as AE does.
command setDimensionsSeparated = 404 { layer: LayerId = 1; path: PropPath = 2; separated: bool = 3; }
/// Set or replace an expression. An empty source removes it. The expression is stored as given, `enabled` as
/// asked, even when it fails to compile (After Effects since CC 2019: an erroring expression stays on, the
/// property shows its pre-expression value and the error is reported); the result carries the diagnostics.
/// `member`: Premation's per-dimension expression on an UNSEPARATED vector (one axis's field in the inspector) —
/// only that dimension carries the source (its number, or component `member` of a vector result); absent = the
/// property's expression, on every dimension. A separated dimension is its own property (`transform/position/x`).
command setExpression = 405 { prop: PropRef = 1; source: string = 2; enabled: bool = 3; member?: u32 = 4; } -> ExpressionResult;
/// Enable / disable expressions (the `=` switch). `member`: only that dimension's expression (see setExpression).
command setExpressionEnabled = 406 { props: PropRef[] = 1; enabled: bool = 2; member?: u32 = 3; }
/// Animation ▸ Keyframe Assistant ▸ Convert Expression to Keyframes (After Effects): sample the property once per
/// `step` (0 = every frame) over `range` (absent = the layer's in → out, clamped to the composition), write the
/// samples as linear keyframes on EVERY dimension (replacing the property's keys; composition frames that map to
/// one layer time keep the first), and DISABLE the expression — it is kept, so it can be switched back on.
/// `member`: only that dimension of an UNSEPARATED vector (its per-dimension expression — a modifier stack on X
/// Position); the other dimensions keep their keys and expressions. Absent = every dimension.
command convertExpressionToKeyframes = 407 { prop: PropRef = 1; range?: TimeRange = 2; step: Time = 3; member?: u32 = 4; } -> KeyframeIds;
/// Link: set a pickwhip expression on `prop` that reads `target`.
command linkProperty = 408 { prop: PropRef = 1; target: PropRef = 2; }

struct PropertyWriteResult {
  /// Set when the write created or replaced a keyframe.
  keyframe?: KeyframeId = 1;
}

struct ExpressionDiagnostic { message: string = 1; line: u32 = 2; column: u32 = 3; }

struct ExpressionResult { ok: bool = 1; diagnostics: ExpressionDiagnostic[] = 2; }

family "Keyframes";

struct KeyframeInsert {
  prop: PropRef = 1;
  time: Time = 2;
  /// Absent = the property's current evaluated value at `time`.
  value?: Value = 3;
  easing?: Easing = 4;
  bezier?: CubicBezier = 5;
  roving?: bool = 6;
  spatialInterp?: SpatialInterp = 7;
  spatialIn: f64[] = 8;
  spatialOut: f64[] = 9;
}

/// Only present fields change. `time` moves this one key (moveKeyframes moves many by a delta); a key moved onto
/// another key of its property replaces it. `dim`: `easing`, `bezier`, `clearBezier` and `continuous` apply to that
/// dimension only (After Effects' per-dimension temporal ease — the graph editor's Scale X handle); every other
/// field is the whole keyframe's.
struct KeyframePatch {
  id: KeyframeId = 1;
  time?: Time = 2;
  value?: Value = 3;
  easing?: Easing = 4;
  bezier?: CubicBezier = 5;
  clearBezier?: bool = 6;
  continuous?: bool = 7;
  roving?: bool = 8;
  spatialInterp?: SpatialInterp = 9;
  spatialIn: f64[] = 10;
  spatialOut: f64[] = 11;
  clearSpatial?: bool = 12;
  label?: u32 = 13;
  dim?: u32 = 14;
}

/// Add keyframes (replacing any at the same time on the same property — the replaced key keeps its id). Returns ids in input order.
command addKeyframes = 500 { keys: KeyframeInsert[] = 1; } -> KeyframeIds;
/// Delete keyframes. Deleting the last key of a property leaves it static at that key's value.
command deleteKeyframes = 501 { ids: KeyframeId[] = 1; }
/// Move keyframes by `delta`. A moved key landing on an unmoved key replaces it; undo restores the replaced key with its id.
command moveKeyframes = 502 [coalesce] { ids: KeyframeId[] = 1; delta: Time = 2; }
/// Patch keyframes (value, easing, handles, tangents, roving, label). Undo restores every patched field.
/// Roving keys (Rove Across Time) are re-timed for constant speed whenever a keyframe command changes their
/// property: each run of roving keys between two non-roving keys is spread over that span by the distance the
/// value travels (a vector: the length of its path through the dimensions). Ends never rove.
command updateKeyframes = 503 [coalesce] { patches: KeyframePatch[] = 1; }
/// Scale keyframe times around `pivot` (Alt-drag a keyframe group).
command scaleKeyframes = 504 [coalesce] { ids: KeyframeId[] = 1; pivot: Time = 2; factor: f64 = 3; }
/// Animation ▸ Keyframe Assistant ▸ Time-Reverse Keyframes: the given keys, as ONE block, are mirrored within the
/// span from the earliest to the latest of them (After Effects) — keys of different properties keep their
/// arrangement, mirrored.
command reverseKeyframes = 505 { ids: KeyframeId[] = 1; }
/// Paste keyframes copied from any property onto `prop`, the first at `time`.
command pasteKeyframes = 506 { prop: PropRef = 1; time: Time = 2; keys: Keyframe[] = 3; } -> KeyframeIds;
/// Replace ALL of a property's keyframes with `keys` (a keyframe assistant's result: The Smoother, The Wiggler,
/// Exponential Scale, Bounce — and their live previews, as a gesture). A key whose `id` names one of the
/// property's keys keeps that id; any other id (or '') gets a new one. Times must be distinct; at least one key
/// (the stopwatch, `setAnimated`, removes them all). Expressions are untouched. Returns the ids in input order.
command setKeyframes = 520 [coalesce] { prop: PropRef = 1; keys: Keyframe[] = 2; } -> KeyframeIds;

struct KeyframeIds { ids: KeyframeId[] = 1; }

family "PropertyGroups";

enum MaskMode { none = 0; add = 1; subtract = 2; intersect = 3; lighten = 4; darken = 5; difference = 6; }

/// Add an effect to each layer (at `index` in the stack, absent = end). Returns the new group paths ('effects/<id>') in layer order.
command addEffect = 600 { layers: LayerId[] = 1; effect: string = 2; index?: u32 = 3; params: PropertyInit[] = 4; } -> GroupList;
/// Add a mask. Returns 'masks/<id>'.
command addMask = 601 { layer: LayerId = 1; path: BezierPath = 2; mode: MaskMode = 3; name?: string = 4; index?: u32 = 5; inverted: bool = 6; } -> GroupList;
/// Add any other group under `parent` by match name: text animator ('text/animators', 'ADBE Text Animator'), selector, shape content (rect, ellipse, polystar, path, fill, stroke, gradient fill/stroke, trim, repeater, merge, offset, round corners, twist, wiggle, zig-zag, pucker), layer style, paint stroke, puppet pin, expression control, essential property.
command addPropertyGroup = 602 { layer: LayerId = 1; parent: PropPath = 2; matchName: string = 3; index?: u32 = 4; init: PropertyInit[] = 5; name?: string = 6; } -> GroupList;
/// Remove groups (effects, masks, animators, …) with their keyframes and expressions. Undo restores them at their index with the same ids.
command removePropertyGroups = 603 { groups: PropRef[] = 1; }
/// Move a group within its parent (reorder effects, masks, animators, shape contents).
command movePropertyGroup = 604 { group: PropRef = 1; toIndex: u32 = 2; }
command duplicatePropertyGroups = 605 { groups: PropRef[] = 1; } -> GroupList;
/// The fx switch / mask enable / animator enable.
command setGroupEnabled = 606 { groups: PropRef[] = 1; enabled: bool = 2; }
command renamePropertyGroup = 607 { group: PropRef = 1; name: string = 2; }
/// Copy groups to other layers (paste effects / masks). Returns new paths in target order.
command copyPropertyGroups = 608 { groups: PropRef[] = 1; toLayers: LayerId[] = 2; } -> GroupList;
/// Apply an animation preset (.ffx-like Premation preset) to layers at `time`.
command applyPreset = 609 { layers: LayerId[] = 1; preset: string = 2; time: Time = 3; } -> GroupList;
/// A plugin effect's action button (param supervision / PF_Cmd_DO_DIALOG equivalents). The plugin's writes are one undo entry.
command invokeEffectAction = 610 { group: PropRef = 1; action: string = 2; payload?: string = 3; }
/// AE's Add ▸ Property: add OPTIONAL properties that exist only once added — a text animator's Anchor Point, Skew Axis, Line Anchor, Character Value, Fill / Stroke Hue·Saturation·Brightness, Stroke Opacity, Fill Color, Stroke Color, and Font Axis properties ('axis<TAG>'). `parent` is the property group ('text/animators/<id>/props'); `names` are the new properties' path leaves. A property already present is kept as it is (AE's menu disables it). Returns the property paths in input order. Undo removes what this added.
command addProperties = 611 { parent: PropRef = 1; names: string[] = 2; } -> PropertyPaths;
/// Remove optional properties (AE: select the property ▸ Delete) with their keyframes and expressions; a font axis property frees its slot. A property that is not optional is refused (`invalidArgument`). Undo restores the properties, their keys and expressions exactly.
command removeProperties = 612 { props: PropRef[] = 1; }
/// B3z — AE Edit ▸ Paste of copied effects from a captured SNAPSHOT (the source may since have been edited or deleted), and applying a saved effect preset. `effects` is a JSON array of captured effects — the editor's CopiedEffect: `{effect: <Effect object: type, params, enabled, opacity, maskId, labelColor, …>, tracks: {<param suffix after 'effect.<id>.'>: Keyframe[]}}` (suffix '' = the legacy single-scalar track `effect.<id>`). Every target layer gets each effect with a FRESH engine-minted id (`fx_<n>`) and fresh keyframe ids, inserted in order at stack `index` (absent = end; past the stack = `outOfRange`). The keys are written at their captured times on each target's keyframe axis (layer time — no playhead shift; the editor's paste has always done this). Returns 'effects/<id>' per pasted effect, layer-major. Undo removes them.
command pasteEffects = 613 { layers: LayerId[] = 1; effects: string = 2; index?: u32 = 3; } -> GroupList;
/// B3z — delete Contents ▸ Stroke N of a shape's stroke stack (`layer/strokes`): the stroke and its keyframe tracks and expressions go, and the tracks of every stroke above it move down one index (strokes bind their tracks by stack index, strokeTracks.ts). `index` is 0-based; out of range is `outOfRange`. Inverse: the stack and the tracks exactly as they were.
command removeStroke = 614 { layer: LayerId = 1; index: u32 = 2; }

/// B3 — PAINT STROKES (AE Effects ▸ Paint ▸ Brush N; the layer's `fx.paint`, src/core/paint/paintStrokes.ts).
/// A stroke is document DATA: `{points: [{x, y}], color, size, opacity, hardness, mode, …}` in layer-local px,
/// renormalised on every write (`normalizeStroke`: defaults filled, fractions clamped, v2 keys only when present).
/// Its numeric params keep their `paint/<id>/<param>` properties (setProperty / keyframes); these commands cover
/// what those cannot: creating, restyling and removing a stroke, its Path and the layer's Paint on Transparent.
///
/// Add one stroke at the end of the layer's paint (the Paint / Clone Stamp / Eraser tool's drag). `stroke` is a JSON
/// object without an `id` (the engine mints `pstroke_<n>`); its `points` must be a non-empty array of finite
/// {x, y}. `keys` are keyframes on the new stroke's numeric params in AE units (Write On: End in %) at LAYER seconds
/// — the axis the stroke's own `inPoint`/`outPoint` use. Returns the id. Inverse: the paint and tracks as they were.
command addPaintStroke = 615 { layer: LayerId = 1; stroke: string = 2; keys: PaintKeyInit[] = 3; } -> PaintStrokeId;
/// Merge `patch` (a JSON object) into one stroke and renormalise: a member set to null CLEARS that key (visible,
/// pressure…); `id` cannot be patched; `points`, when given, follows addPaintStroke's rule. Shift-continue sends the
/// joined points + pen arrays, the video switch `{visible: false}` / `{visible: null}`. Inverse: the stroke as it was.
command updatePaintStroke = 616 [coalesce] { layer: LayerId = 1; stroke: string = 2; patch: string = 3; }
/// Delete strokes with every track, expression and data track under `paint.<id>.`. Unknown id: `notFound`.
/// Inverse: the strokes at their index and their tracks exactly.
command removePaintStrokes = 617 { layer: LayerId = 1; strokes: string[] = 2; }
/// AE Paint on Transparent — the layers show ONLY their paint. A layer without strokes: `notFound`.
command setPaintOnTransparent = 618 { layers: LayerId[] = 1; on: bool = 2; }
/// Drawing with a stroke selected REPLACES its Path (AE): with the Path animated (a `paint.<id>.path` data track),
/// a Path key at `time` (comp time → the layer's keyframe axis); else the static points, dropping the per-point
/// pen input recorded for the old path. `points` is a JSON array of finite {x, y}, non-empty.
command setPaintStrokePath = 619 { layer: LayerId = 1; stroke: string = 2; points: string = 3; time: Time = 4; }
/// The Path stopwatch: ON keys the current points at `time` (already animated: no change); OFF removes the Path
/// keyframes (the static points stay). Inverse: the track as it was.
command setPaintPathAnimated = 620 { layer: LayerId = 1; stroke: string = 2; animated: bool = 3; time: Time = 4; }

/// A keyframe on a new paint stroke's numeric param (`start`, `end`, `diameter`, … — paintProps.ts), AE units.
struct PaintKeyInit { param: string = 1; time: f64 = 2; value: f64 = 3; }
struct PaintStrokeId { stroke: string = 1; }

/// Which structural edit `editPathTopology` replays (packages/workspace pathTopology.ts `PathTopologyEdit`).
enum PathTopologyKind { insert = 0; remove = 1; firstVertex = 2; reverse = 3; extend = 4; }

/// A structural path edit, replayable on every state of an outline.
struct PathTopologyOp {
  kind: PathTopologyKind = 1;
  /// insert: the segment from vertex `segment` to the next one (wrapping when closed), split at curve parameter `u`, strictly inside (0, 1) — de Casteljau, the drawn curve is unchanged; the new vertex lands at `segment + 1`.
  segment: u32 = 2;
  u: f64 = 3;
  /// remove: the vertices to delete (at least one; at least 2 must stay). firstVertex: exactly one index.
  indices: u32[] = 4;
  /// extend: the vertices a continued open outline gains in EVERY state, appended (prepended when `atStart`), in the path's own space. Its `closed` and feather points are ignored; its vertex states are kept.
  points?: BezierPath = 5;
  atStart: bool = 6;
}

/// B3 — a STRUCTURAL edit of a path property — a mask's `masks/<id>/path` or a shape layer's `layer/path.points` — in EVERY state: the static outline and each keyframe (an outline cannot gain a vertex, open, or start elsewhere at one key only: keys whose vertex counts differ hold instead of morphing). `op` first, on each state's current closed state: split a segment, remove vertices, Set First Vertex (a closed outline rotates; an open one can only start at its last vertex, which reverses it), Reverse Path Direction, or continue an open outline; then `closed`, the outline's Closed switch in every state. At least one of the two. A state the op does not apply to (a segment or vertex it lacks) is left as it is; an op that applies to no state is `invalidArgument` and changes nothing. Per-vertex feathers and editing state travel with their vertices; keyframe ids, times and easing are kept. Undo restores every state exactly.
command editPathTopology = 630 { prop: PropRef = 1; op?: PathTopologyOp = 2; closed?: bool = 3; }

/// B3 — replace a shape layer's drawn outline with independent RUNS (the Knife's cut, a boolean's islands): stored as the layer's subpaths, each run with its own closed state; the single-run outline is cleared, the layer's shape type becomes `path` (a cut rectangle is no longer a rectangle), and a layer without Geometry gets one. At least one run, each of at least 2 vertices. A layer that is not a shape is `invalidArgument`; an animated outline (`layer/path.points` keyed — the keys would win over the runs every frame) is `animated`. Undo restores the outline exactly.
command setShapeOutline = 631 { layer: LayerId = 1; runs: BezierPath[] = 2; }

struct PropertyPaths { paths: PropPath[] = 1; }
