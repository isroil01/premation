# Production build settings — loaded by Vite for `npm run build` / `npm run dist`
# (mode=production). Dev is unaffected: see .env.development and .env.local.
#
# Everything here is commented out, so an unconfigured `npm run dist` keeps its
# historical behaviour: a desktop app that talks to a motion-back on
# http://localhost:4000 (run it yourself, or bundle it — see
# electron-builder.selfhosted.yml).
#
# ── Server mode: point the app at a DEPLOYED backend ─────────────────────────
# The absolute origin of motion-back — scheme + host + port, no path, no
# trailing slash. Baked into the bundle at build time, and used for two things
# that must agree: the API base URL (src/core/api/env.ts) and the shell's CSP
# `connect-src` (src/core/api/csp.ts). Setting it here does both.
#
# This is the ONE variable that turns a local build into a client for your
# server. Without it a packaged app cannot reach a remote API at all.
#
# Points the desktop app (Windows / macOS / Linux packaged builds) at the
# deployed motion-back on Railway.
VITE_BACKEND_ORIGIN=https://motion-back-production.up.railway.app

# Origins that serve user media, comma-separated. Defaults to
# https://res.cloudinary.com — motion-back's production storage driver — so the
# default is already correct for a Cloudinary-backed deployment.
#
# Set it when assets come from somewhere else (your own CDN, an S3 bucket
# domain). Set it EMPTY (`VITE_MEDIA_ORIGINS=`) when motion-back runs the
# local-disk driver, since then assets are served from the backend origin, which
# is allowed anyway. An asset host missing from this list is blocked by CSP:
# images silently fail to draw and audio layers fail to decode.
#VITE_MEDIA_ORIGINS=https://res.cloudinary.com

# ── Local-first / bundle storage ─────────────────────────────────────────────
# `.motion` directory bundles + the Version History panel. On in dev
# (.env.development); off in production builds until the on-device save path has
# been verified on a real install — see ARCHITECTURE_RFC.md.
#VITE_LOCAL_FIRST=1

# ── Edition ──────────────────────────────────────────────────────────────────
# Unset (or anything but local/oss) = the full server edition: accounts, cloud
# projects, billing, AI, plugin registry. The open-source build is produced by
# the dedicated scripts (`npm run dist:local`) which set VITE_EDITION=local —
# do not set it here, or every build becomes the local edition.
